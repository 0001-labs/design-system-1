---
import apps from '../../../DS1/x-app/catalog.json';
---
<section id="app-icons" class="not-content" data-ds-not-prose>
  <h2>App icons</h2>
  <p>Original app logos, in their own colours. Download an SVG for app cards, integrations and app sections.</p>
  <ul class="apps">
    {apps.map(app => <li><a href={`/icons/apps/${app.key}.svg`} download={`${app.key}.svg`}>
      <img src={`/icons/apps/${app.key}.svg`} width="40" height="40" alt="" loading="lazy" />
      <span>{app.name}</span>
    </a></li>)}
  </ul>
  <p>20, 40 or 60px, or a custom size. Each logo keeps its proportions and colours in both themes.</p>
</section>
<style>
  section { margin-bottom: 40px; }
  .apps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr)); gap: 20px; list-style: none; padding: 0; margin: 20px 0; }
  .apps a { display: grid; gap: 20px; padding: 20px; color: inherit; text-decoration: none; border: 1px solid var(--ds-border-color, currentColor); border-radius: 4px; }
  .apps img { display: block; object-fit: contain; }
  .apps span { font-size: 14px; line-height: 20px; }
  .apps a:hover { background: var(--ds-fill); }
  .apps a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
</style>
