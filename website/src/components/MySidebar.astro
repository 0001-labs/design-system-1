---
const { sidebar } = Astro.locals.starlightRoute;
---
<div class="docs-sidebar-shell">
  <ds-sidebar id="docs-navigation" label="Documentation" narrow disclosure-position="start" expand-icon="chevron-down" collapse-icon="chevron-up" data-groups={JSON.stringify(sidebar)}>
    {/* Signed in, the way between the two spaces: back to the documentation, or back into the design system.
        The arrow stands in the disclosure column, so the words line up with every row's. */}
    <a slot="header" id="shell-back" class="ds-row ds-row--nav shell-back" href="/" hidden><ds-icon type="left" aria-hidden="true"></ds-icon><span id="shell-back-words" class="ds-row__name">Back to documentation</span></a>
    <div slot="footer" class="docs-sidebar-footer">
      <ds-button href="https://github.com/0001-labs/Design-system-1">GitHub</ds-button>
      <a id="docs-account" href="/app/signin">Sign in</a>
    </div>
  </ds-sidebar>
</div>

<script>
  import '../../../DS1/3-unit/ds-sidebar';
  import '../../../DS1/2-core/ds-tag';
  import '../../../DS1/2-core/ds-icon';
  import { watchCuts } from '../../../DS1/0-face/cut-fade';
  import { readAppComponents, placeAppNavigation, type AppComponent } from '../lib/app-navigation';
  import '../../../DS1/1-root/row.css';
  import { translate } from '../../../DS1/0-face/i18n';
  import { LAYERS } from '../../../shared/component-directory';
  import { libraryWorkspaceHref, type LibraryNavigation } from '../../../shared/library-navigation';
  import { editorChoice, editorSidebarItems, type EditorNavigation } from '../../../shared/editor-navigation';
  import { ACTIVE_LIBRARY_EVENT, ACTIVE_LIBRARY_KEY, readActiveLibrary } from '../../../shared/active-library';
  import { backLink, readShellSnapshot, shellSpace } from '../lib/shell';
  import type { SidebarItem } from '../../../DS1/3-unit/ds-sidebar';
  const navigation = document.querySelector('ds-sidebar#docs-navigation')!;
  type Entry = { label: string; href?: string; isCurrent?: boolean; entries?: Entry[] };
  const groups: Entry[] = JSON.parse(navigation.dataset.groups ?? '[]');
  let library: LibraryNavigation | null = null;
  // Design system 1's component editor, framed on its docs page: its components take the docs groups' place.
  let editor: EditorNavigation | null = null;
  let appComponents: AppComponent[] = [];
  const collapsed = new Set<string>();
  // Until the server answers, the owner's System row follows this browser's snapshot: presentation only.
  let owner = document.documentElement.hasAttribute("data-ds-owner") || (document.documentElement.hasAttribute("data-signed-in") && readShellSnapshot()?.owner === true);
  let signedIn = document.documentElement.hasAttribute("data-signed-in");
  const path = location.pathname.replace(/\/$/, '');
  // Signed in, the design system is its own space (the base editor, a library, the list, the account); every other page is the documentation.
  const space = shellSpace(location.pathname, location.search);
  const translationKeys: Record<string, string> = {
    'Start Here': 'startHere', 'Built-ins': 'builtIns', Root: 'root', Core: 'core', Unit: 'unit', Page: 'page',
    Introduction: 'introduction', 'Manual Setup': 'manualSetup', Theming: 'theming', 'Mobile Detection': 'mobileDetection',
    Styling: 'styling', Fonts: 'fonts', Button: 'button', Text: 'text', Link: 'link', Icon: 'icon', Tooltip: 'tooltip',
    Navigation: 'navigation', List: 'list', Panel: 'panel', Card: 'card', Layout: 'layout', Grid: 'grid',
  };
  function label(text: string): string {
    if (text === 'Start Here') return 'Start here';
    const key = translationKeys[text] ?? text;
    const translated = translate(key);
    return translated === key ? text : translated;
  }

  const overviewPaths: Record<string, string> = {
    Root: '/1-root/overview/', Core: '/2-core/overview/',
    Unit: '/3-unit/overview/', Page: '/4-page/overview/',
    Icon: '/2-core/icon/',
  };
  function rows(entries: Entry[], depth = 0, parent = ''): SidebarItem[] {
    return entries.flatMap((entry, index) => {
      const href = entry.href ?? (entry.entries ? overviewPaths[entry.label] : undefined);
      const id = href ?? `${parent}/group-${index}`;
      const item: SidebarItem = { id, label: label(entry.label), depth, href, current: href ? path === href.replace(/\/$/, "") : entry.isCurrent };
      if (!entry.entries) return [item];
      item.expanded = !collapsed.has(id);
      return [item, ...(item.expanded ? rows(entry.entries, depth + 1, id) : [])];
    });
  }
  // One square between the design system's components and its own views.
  const gap = document.createElement('div');
  gap.slot = 'shell-gap';
  gap.className = 'sidebar-gap';
  gap.setAttribute('aria-hidden', 'true');
  navigation.append(gap);
  const gapAfterLast = (items: SidebarItem[]) => { if (items.length) items[items.length - 1] = { ...items[items.length - 1], afterSlot: gap.slot }; };
  const back = document.querySelector<HTMLAnchorElement>('#shell-back')!;
  watchCuts().watch(back.querySelector('#shell-back-words')!);
  function renderBack() {
    back.hidden = !signedIn;
    const { label: words, href } = backLink(space, space === 'documentation' ? readActiveLibrary() : null);
    back.querySelector('#shell-back-words')!.textContent = words;
    back.href = href;
  }
  function designItems(): SidebarItem[] {
    const items: SidebarItem[] = [];
    if (space === 'base' && editor) {
      const { components, views } = editorSidebarItems(editor, location.pathname);
      items.push(...components);
      gapAfterLast(items);
      items.push(...views);
    }
    if (space === 'library' && library) {
      const open = library;
      items.push(...LAYERS.flatMap(layer => {
        const id = `library-layer-${layer.number}`;
        const expanded = !collapsed.has(id);
        return [{ id, label: `${layer.number} ${layer.name}`, expanded }, ...(expanded ? layer.entries.map(entry => ({
          id: entry.href, label: entry.name, depth: 1, href: libraryWorkspaceHref({ ...open, view: undefined }, entry.href), current: !open.view && open.component === entry.href,
        })) : [])];
      }));
      gapAfterLast(items);
      items.push({ id: 'library-overview', label: 'Overview', href: libraryWorkspaceHref({ ...open, view: 'overview' }), current: open.view === 'overview' });
    }
    return items;
  }
  function renderNavigation() {
    renderBack();
    const design = signedIn && space !== 'documentation';
    navigation.label = !design ? 'Documentation' : library ? `${library.name} navigation` : editor ? 'Design system 1 components' : 'Design system navigation';
    // The list of libraries and the account have only the way back; the base waits for its frame's components.
    navigation.empty = design ? '' : 'No items';
    if (design) { navigation.items = placeAppNavigation(navigation, designItems(), []); return; }
    navigation.items = placeAppNavigation(navigation, rows(groups), appComponents);
    if (owner) navigation.items = [...navigation.items, { id: 'system', label: 'System', href: 'https://system.designsystem1.com/' }];
  }
  const account = document.querySelector<HTMLAnchorElement>('#docs-account')!;
  const renderAccount = () => { account.hidden = signedIn; };
  renderAccount();
  renderNavigation();
  window.addEventListener('ds1-library-navigation', event => {
    library = (event as CustomEvent).detail.library;
    renderNavigation();
  });
  window.addEventListener('ds1-editor-navigation', event => {
    editor = (event as CustomEvent).detail.editor;
    renderNavigation();
  });
  window.addEventListener(ACTIVE_LIBRARY_EVENT, () => renderNavigation());
  window.addEventListener('storage', event => { if (event.key === ACTIVE_LIBRARY_KEY || event.key === null) renderNavigation(); });
  navigation.addEventListener('sidebar-activate', event => {
    const id = (event as CustomEvent).detail.id;
    const choice = editor ? editorChoice(id) : null;
    if (choice) {
      const frame = document.querySelector<HTMLIFrameElement>('#library-app');
      if (!frame?.contentWindow) return;
      event.preventDefault();
      frame.contentWindow.postMessage({ type: 'ds1:editor-open', ...choice }, location.origin);
      return;
    }
    if (!library || (id !== 'library-overview' && !LAYERS.some(layer => layer.entries.some(entry => entry.href === id)))) return;
    const frame = document.querySelector<HTMLIFrameElement>('#library-app');
    if (!frame?.contentWindow) return;
    event.preventDefault();
    frame.contentWindow.postMessage(id === 'library-overview' ? { type: 'ds1:library-overview' } : { type: 'ds1:library-component', component: id }, location.origin);
  });
  window.addEventListener("hashchange", () => { renderNavigation(); });
  window.addEventListener("ds1-navigation-auth", event => {
    const detail = (event as CustomEvent).detail;
    signedIn = detail.authenticated;
    owner = signedIn && detail.owner === true && !detail.loading;
    if (!detail.loading) appComponents = readAppComponents(detail);
    if (!signedIn) { library = null; editor = null; }
    renderNavigation(); renderAccount();
  });
  window.addEventListener("translations-ready", () => { renderNavigation(); });
  window.addEventListener("language-changed", () => { renderNavigation(); });
  // Replay the authenticated summary after all sidebar listeners are ready.
  window.dispatchEvent(new Event('ds1:navigation-auth-request'));
  navigation.addEventListener('sidebar-toggle', event => {
    const { id, expanded } = (event as CustomEvent).detail;
    if (expanded) collapsed.delete(id); else collapsed.add(id);
    renderNavigation();
    navigation.updateComplete.then(() => navigation.focusItem(id));
  });
</script>

<style>
  .docs-sidebar-shell { display: flex; flex: 1; min-height: 0; height: 100%; padding: var(--site-unit); overflow: hidden; }
  ds-sidebar { width: 100%; height: 100%; }
  .docs-sidebar-footer { display: flex; align-items: center; gap: calc(var(--site-unit) / 2); height: calc(2 * var(--site-unit)); border-top: 1px solid var(--ds1-docs-header-border); font-size: var(--ds-type-size-default); }
  #docs-navigation :global(.private-component-link) { width: 100%; color: var(--ds-text-color-muted); text-decoration: none; padding-inline-start: calc(4px * var(--sf, 1) + 2 * var(--site-unit)); gap: calc(4px * var(--sf, 1)); }
  /* Rows the page slots into the navigation keep their height when the list scrolls. */
  #docs-navigation :global(:is(.sidebar-gap, .private-component-links)) { flex: none; }
  #docs-navigation :global(.sidebar-gap) { height: var(--site-unit); }
  /* The way back: one square, its arrow in the disclosure column and its words where every row's start, a square above the rows. */
  #shell-back { width: fit-content; max-width: calc(100% + 8px * var(--sf, 1)); margin: 0 calc(-4px * var(--sf, 1)) var(--site-unit); padding-inline: calc(4px * var(--sf, 1)); gap: 0; align-items: flex-end; }
  #shell-back[hidden] { display: none; }
  .shell-back ds-icon { flex: none; display: flex; justify-content: center; width: var(--site-unit); }
  .shell-back:hover { background: var(--ds-row-fill-hover, var(--ds-fill)); }
  .shell-back:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  #docs-account { display: inline-flex; align-items: center; justify-content: center; margin-left: auto; min-width: var(--site-unit); height: var(--site-unit); color: inherit; text-decoration: none; }
  #docs-account:hover { text-decoration: underline; }
  #docs-account:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  #docs-account[hidden] { display: none; }
  /* The account lives in the header once signed in, from the first frame. */
  :global(html[data-signed-in]) #docs-account { display: none; }
</style>
