---
// After a newspaper's puzzle page: a quick crossword of eleven by eleven in the British manner,
// where every other letter is checked, each cell exactly two squares; clues across and down in two
// columns, and yesterday's solution printed small, one cell a square. The grid can be filled in.
import AlignedStudy from '../../../layouts/AlignedStudy.astro';

const GRID = [
  'costume#fur',
  'o#a#n#m#o#a',
  'mad#cabaret',
  'p###l#e#e##',
  'apple#river',
  's#r#####e#e',
  'swamp#lyric',
  '##i#i#u###e',
  'horizon#ski',
  'a#i#z#a#o#p',
  'tie#acrobat',
];
const YESTERDAY = [
  'veranda#day',
  'i#a#o#r#e#a',
  'lot#blossom',
  'l###l#m#k##',
  'angle#attic',
  'g#o#####o#o',
  'elbow#depot',
  '##l#r#i###t',
  'opinion#sea',
  'r#n#s#e#k#g',
  'bus#turbine',
];
const CLUES: Record<string, string> = {
  costume: 'Outfit for a fancy-dress party',
  fur: 'Coat of a fox',
  mad: 'Hopping ___, very angry',
  cabaret: 'Night-club show of songs and sketches',
  apple: 'Fruit in a strudel',
  river: 'The Thames or the Danube',
  swamp: 'Wet, spongy ground where alligators lurk',
  lyric: 'Words of a song',
  horizon: 'Line where the sea seems to meet the sky',
  ski: 'Glide down a snowy slope',
  tie: 'Draw, in a football match',
  acrobat: 'Tumbler on the circus trapeze',
  compass: 'Its needle points north',
  hat: 'Bowler or beret',
  sad: 'Down in the dumps',
  prairie: 'Grassland of the Midwest',
  uncle: 'Father’s brother',
  pizza: 'Margherita, for one',
  ember: 'Glowing coal in a dying fire',
  lunar: 'Of the moon',
  forever: 'For all time',
  sob: 'Cry noisily',
  rat: 'Rodent led away by the Pied Piper',
  receipt: 'Proof of purchase from the till',
};

type Slot = { n: number; dir: 'a' | 'd'; r: number; c: number; word: string; cells: [number, number][] };
function number(grid: string[]) {
  const size = grid.length;
  const open = (r: number, c: number) => r >= 0 && c >= 0 && r < size && c < size && grid[r][c] !== '#';
  const numbers: number[][] = grid.map(row => [...row].map(() => 0));
  const slots: Slot[] = [];
  let n = 0;
  for (let r = 0; r < size; r++) {
    for (let c = 0; c < size; c++) {
      if (!open(r, c)) continue;
      const across = !open(r, c - 1) && open(r, c + 1);
      const down = !open(r - 1, c) && open(r + 1, c);
      if (!across && !down) continue;
      numbers[r][c] = ++n;
      for (const dir of ['a', 'd'] as const) {
        if ((dir === 'a' && !across) || (dir === 'd' && !down)) continue;
        const cells: [number, number][] = [];
        for (let k = 0; ; k++) {
          const rr = dir === 'd' ? r + k : r;
          const cc = dir === 'a' ? c + k : c;
          if (!open(rr, cc)) break;
          cells.push([rr, cc]);
        }
        slots.push({ n, dir, r, c, cells, word: cells.map(([rr, cc]) => grid[rr][cc]).join('') });
      }
    }
  }
  return { numbers, slots };
}
const today = number(GRID);
const across = today.slots.filter(s => s.dir === 'a');
const down = today.slots.filter(s => s.dir === 'd');
const yesterday = number(YESTERDAY).numbers;
---
<AlignedStudy slug="crossword" theme="light">
  <main class="stage puzzle">
    <header class="masthead">
      <p class="paper">The Evening Courier</p>
      <p class="edition">Saturday 14 November 2026<br />Puzzles, page 38</p>
    </header>

    <h1 class="title">Quick crossword <span>No. 4,812</span></h1>
    <p class="setter">Set by Kittiwake</p>

    <div class="grid" id="grid" data-own-keys role="grid" aria-label="Crossword grid, eleven by eleven">
      {GRID.map((row, r) => (
        <div class="row" role="row">
          {[...row].map((ch, c) => ch === '#'
            ? <span class="block" role="gridcell" aria-hidden="true"></span>
            : (
              <label class="cell" role="gridcell">
                {today.numbers[r][c] > 0 && <span class="num">{today.numbers[r][c]}</span>}
                <input
                  maxlength="1"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  data-r={r}
                  data-c={c}
                  data-answer={ch}
                  aria-label={`Row ${r + 1}, column ${c + 1}`}
                />
              </label>
            ))}
        </div>
      ))}
    </div>

    <div class="actions">
      <button type="button" id="check">Check</button>
      <button type="button" id="clear">Clear</button>
      <p class="status" id="status" aria-live="polite">Click a square and type. Arrows move; click it again to turn.</p>
    </div>

    <section class="clues across" aria-labelledby="across-title">
      <h2 id="across-title">Across</h2>
      <ol>
        {across.map(s => (
          <li data-slot={`${s.n}a`}><b>{s.n}</b><span>{CLUES[s.word]} <i>({s.word.length})</i></span></li>
        ))}
      </ol>
    </section>
    <section class="clues down" aria-labelledby="down-title">
      <h2 id="down-title">Down</h2>
      <ol>
        {down.map(s => (
          <li data-slot={`${s.n}d`}><b>{s.n}</b><span>{CLUES[s.word]} <i>({s.word.length})</i></span></li>
        ))}
      </ol>
    </section>

    <figure class="yesterday">
      <figcaption>Yesterday’s solution, No. 4,811</figcaption>
      <div class="mini" aria-hidden="true">
        {YESTERDAY.map((row, r) => [...row].map((ch, c) => ch === '#'
          ? <span class="b"></span>
          : <span>{yesterday[r][c] > 0 && <i>{yesterday[r][c]}</i>}{ch}</span>))}
      </div>
    </figure>

    <p class="footnote">Tomorrow: the Sunday Cryptic, set by Plover. Prize of a fountain pen for the first correct entry opened on Thursday.</p>
  </main>
</AlignedStudy>

<script define:vars={{ slots: today.slots.map(s => ({ id: `${s.n}${s.dir}`, dir: s.dir, cells: s.cells })) }}>
  // Plain script with the slots handed over: the entry follows the word, Backspace steps back,
  // arrows move square by square, a second click on a square turns across to down.
  const grid = document.getElementById('grid');
  const inputs = [...grid.querySelectorAll('input')];
  const at = new Map(inputs.map(i => [`${i.dataset.r},${i.dataset.c}`, i]));
  const status = document.getElementById('status');
  let dir = 'a';
  let current = null;

  const slotFor = (input, d) => slots.find(s => s.dir === d && s.cells.some(([r, c]) => r === +input.dataset.r && c === +input.dataset.c));
  function paint() {
    inputs.forEach(i => i.parentElement.classList.remove('word'));
    document.querySelectorAll('.clues li').forEach(li => li.classList.remove('on'));
    if (!current) return;
    const slot = slotFor(current, dir) || slotFor(current, dir === 'a' ? 'd' : 'a');
    if (!slot) return;
    dir = slot.dir;
    slot.cells.forEach(([r, c]) => at.get(`${r},${c}`).parentElement.classList.add('word'));
    document.querySelector(`[data-slot="${slot.id}"]`)?.classList.add('on');
  }
  function go(input) { if (input) { input.focus(); input.select(); } }
  function step(input, delta) {
    const slot = slotFor(input, dir);
    if (!slot) return;
    const k = slot.cells.findIndex(([r, c]) => r === +input.dataset.r && c === +input.dataset.c);
    const next = slot.cells[k + delta];
    if (next) go(at.get(`${next[0]},${next[1]}`));
  }
  function move(input, dr, dc) {
    let r = +input.dataset.r;
    let c = +input.dataset.c;
    for (let k = 0; k < 11; k++) {
      r += dr; c += dc;
      const next = at.get(`${r},${c}`);
      if (next) { dir = dc ? 'a' : 'd'; go(next); return; }
    }
  }

  inputs.forEach(input => {
    input.addEventListener('mousedown', () => {
      if (document.activeElement === input) { dir = dir === 'a' ? 'd' : 'a'; requestAnimationFrame(paint); }
    });
    input.addEventListener('focus', () => { current = input; paint(); });
    input.addEventListener('input', () => {
      const letter = input.value.replace(/[^a-z]/gi, '').slice(-1).toUpperCase();
      input.value = letter;
      input.parentElement.classList.remove('wrong');
      if (letter) step(input, 1);
    });
    input.addEventListener('keydown', event => {
      const keys = { ArrowLeft: [0, -1], ArrowRight: [0, 1], ArrowUp: [-1, 0], ArrowDown: [1, 0] };
      if (keys[event.key]) { event.preventDefault(); move(input, ...keys[event.key]); return; }
      if (event.key === 'Backspace' && !input.value) { event.preventDefault(); step(input, -1); return; }
      if (event.key === ' ') { event.preventDefault(); dir = dir === 'a' ? 'd' : 'a'; paint(); }
    });
  });

  document.getElementById('check').addEventListener('click', () => {
    let wrong = 0;
    let empty = 0;
    inputs.forEach(i => {
      const ok = i.value.toLowerCase() === i.dataset.answer;
      i.parentElement.classList.toggle('wrong', !!i.value && !ok);
      if (!i.value) empty++;
      else if (!ok) wrong++;
    });
    status.textContent = wrong
      ? `${wrong} ${wrong === 1 ? 'letter is' : 'letters are'} wrong, marked in red.`
      : empty ? `All correct so far; ${empty} squares to go.` : 'Solved. Every letter is right.';
  });
  document.getElementById('clear').addEventListener('click', () => {
    inputs.forEach(i => { i.value = ''; i.parentElement.classList.remove('wrong'); });
    status.textContent = 'Cleared. Click a square and type.';
    go(inputs[0]);
  });
</script>

<style is:global>
  html { background: #e9e8e2; }
  .puzzle {
    --paper: #e9e8e2;
    --ink: #1c1c1a;
    --word: #c9dcec;
    --here: #f6d24a;
    --red: #c4261d;
    color: var(--ink);
    background: var(--paper);
    font-family: Charter, 'Iowan Old Style', Georgia, serif;
    font-size: calc(15px * var(--sf));
    line-height: var(--u);
  }

  .masthead { grid-column: 3 / -3; grid-row: 2 / span 3; display: flex; justify-content: space-between; align-items: end; border-bottom: calc(3px * var(--sf)) solid var(--ink); }
  .paper { margin: 0; font: calc(44px * var(--sf)) / calc(3 * var(--u)) Superclarendon, Rockwell, Georgia, serif; letter-spacing: -0.02em; }
  .edition { margin: 0; text-align: right; font-size: calc(13px * var(--sf)); }

  .title { grid-column: 3 / span 22; grid-row: 6 / span 1; margin: 0; font: bold calc(18px * var(--sf)) / var(--u) Charter, Georgia, serif; white-space: nowrap; }
  .title span { font-weight: normal; }
  .setter { grid-column: 3 / span 22; grid-row: 6 / span 1; margin: 0; justify-self: end; font-style: italic; }

  /* Eleven cells of two squares, a hairline between them drawn inside each cell. */
  .grid { grid-column: 3 / span 22; grid-row: 8 / span 22; display: grid; grid-template-rows: repeat(11, calc(2 * var(--u))); outline: calc(2px * var(--sf)) solid var(--ink); }
  .row { display: grid; grid-template-columns: repeat(11, calc(2 * var(--u))); }
  .block { background: var(--ink); }
  .cell { position: relative; display: block; box-shadow: inset 0 0 0 0.5px var(--ink); background: #fbfbf8; cursor: text; }
  .cell.word { background: var(--word); }
  .cell:focus-within { background: var(--here); }
  .cell .num { position: absolute; left: calc(3px * var(--sf)); top: calc(1px * var(--sf)); font: calc(10px * var(--sf)) / calc(12px * var(--sf)) 'Avenir Next', var(--typeface-regular), sans-serif; pointer-events: none; }
  .cell input {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding-top: calc(6px * var(--sf));
    text-align: center;
    font: 500 calc(22px * var(--sf)) / calc(2 * var(--u)) 'Avenir Next', var(--typeface-medium), sans-serif;
    text-transform: uppercase;
    caret-color: transparent;
    cursor: text;
  }
  .cell.wrong input { color: var(--red); text-decoration: line-through; text-decoration-thickness: calc(2px * var(--sf)); }

  .actions { grid-column: 3 / span 22; grid-row: 31 / span 2; display: grid; grid-template-columns: calc(4 * var(--u)) calc(4 * var(--u)) 1fr; column-gap: var(--u); align-items: start; }
  .actions button { all: unset; height: var(--u); text-align: center; border: 1px solid var(--ink); box-sizing: border-box; font: 500 calc(13px * var(--sf)) / calc(var(--u) - 2px) 'Avenir Next', var(--typeface-medium), sans-serif; cursor: pointer; }
  .actions button:hover { background: var(--ink); color: var(--paper); }
  .actions button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .status { margin: 0; font-style: italic; font-size: calc(13px * var(--sf)); }

  .clues h2 { margin: 0 0 var(--u); font: bold calc(18px * var(--sf)) / var(--u) Charter, Georgia, serif; border-bottom: 1px solid var(--ink); padding-bottom: 0; height: var(--u); }
  .clues ol { margin: 0; padding: 0; list-style: none; }
  .clues li { display: grid; grid-template-columns: calc(2 * var(--u)) 1fr; }
  .clues li b { font-family: 'Avenir Next', var(--typeface-medium), sans-serif; font-weight: 600; font-size: calc(13px * var(--sf)); }
  .clues li i { font-style: normal; color: #6b6a64; }
  .clues li.on { background: var(--word); box-shadow: calc(-0.5 * var(--u)) 0 0 var(--word), calc(0.5 * var(--u)) 0 0 var(--word); }
  .across { grid-column: 28 / span 16; grid-row: 6 / span 18; }
  .down { grid-column: 46 / -3; grid-row: 6 / span 18; max-width: calc(18 * var(--u)); }

  /* Yesterday's grid at one square a cell, the letters small. */
  .yesterday { grid-column: 28 / span 16; grid-row: -15 / span 13; margin: 0; }
  .yesterday figcaption { font-style: italic; height: var(--u); margin-bottom: var(--u); }
  .mini { display: grid; grid-template-columns: repeat(11, var(--u)); grid-auto-rows: var(--u); width: max-content; outline: 1px solid var(--ink); }
  .mini span { position: relative; box-shadow: inset 0 0 0 0.5px var(--ink); text-align: center; font: 500 calc(11px * var(--sf)) / calc(var(--u) + 2px) 'Avenir Next', sans-serif; text-transform: uppercase; color: #3d3c38; }
  .mini span i { position: absolute; left: 1px; top: -1px; font: calc(6px * var(--sf)) / 1 'Avenir Next', sans-serif; font-style: normal; }
  .mini .b { background: var(--ink); }
  .footnote { grid-column: 46 / span 16; grid-row: -9 / span 4; margin: 0; font-style: italic; font-size: calc(13px * var(--sf)); max-width: calc(16 * var(--u)); }

  :root[data-narrow] .puzzle { padding-bottom: calc(3 * var(--u)); }
  :root[data-narrow] .puzzle > * { grid-column: 2 / -2; grid-row: auto; max-width: none; }
  :root[data-narrow] .masthead { display: block; margin-top: var(--u); padding-bottom: var(--u); }
  :root[data-narrow] .paper { font-size: calc(30px * var(--sf)); line-height: calc(2 * var(--u)); }
  :root[data-narrow] .edition { text-align: left; }
  :root[data-narrow] .title { margin-top: var(--u); }
  :root[data-narrow] .setter { justify-self: start; }
  :root[data-narrow] .grid { justify-self: start; grid-template-rows: repeat(11, var(--u)); margin-block: var(--u); width: max-content; }
  :root[data-narrow] .row { grid-template-columns: repeat(11, var(--u)); }
  :root[data-narrow] .cell input { padding-top: calc(3px * var(--sf)); font-size: calc(14px * var(--sf)); line-height: var(--u); }
  :root[data-narrow] .cell .num { font-size: calc(6px * var(--sf)); line-height: 1; left: 1px; top: 0; }
  :root[data-narrow] .actions { grid-template-columns: calc(4 * var(--u)) calc(4 * var(--u)); row-gap: var(--u); }
  :root[data-narrow] .status { grid-column: 1 / -1; }
  :root[data-narrow] .clues { margin-top: var(--u); }
  :root[data-narrow] .yesterday { margin-top: var(--u); }
  :root[data-narrow] .footnote { margin-top: var(--u); }
</style>
