---
// After a hospital corridor seen from above: coloured lines painted on the linoleum, each a square
// wide, leaving one junction as a bundle and peeling off one by one to a door. The departments are
// feelings. Every line runs on its own row of squares and turns on a radius of whole squares, and
// Patience, of course, takes the long way round.
import AlignedStudy from '../../../layouts/AlignedStudy.astro';

const WARDS = [
  { id: 'courage', name: 'Courage', rooms: 'C1–C12', line: 'Ask what you came to ask.', colour: '#d43a2f', ink: '#fff' },
  { id: 'relief', name: 'Relief', rooms: 'E1–E9', line: 'Breathe out. It came back clear.', colour: '#2f9a5a', ink: '#fff' },
  { id: 'patience', name: 'Patience', rooms: 'P1, eventually', line: 'This line is longer on purpose.', colour: '#f1c232', ink: '#3a2e00' },
  { id: 'rest', name: 'Rest', rooms: 'R1–R40, beds', line: 'Lie down. Nobody counts.', colour: '#2c66c3', ink: '#fff' },
  { id: 'laughter', name: 'Laughter', rooms: 'L1–L6', line: 'Visitors welcome. Loud ones too.', colour: '#ef7b22', ink: '#fff' },
  { id: 'grief', name: 'Grief', rooms: 'G1–G4', line: 'Open all night. No appointment.', colour: '#7656a3', ink: '#fff' },
  { id: 'out', name: 'Way out', rooms: 'Level 0', line: 'Taxis, the car park and the rest of your day.', colour: '#30353a', ink: '#fff' },
];
---
<AlignedStudy slug="hospital-lines" theme="light">
  <main class="stage hl" id="hl">
    <section class="hl-floor" id="floor" aria-label="Floor plan of Ward F">
      <div class="hl-wall" aria-hidden="true"></div>
      <svg class="hl-lines" id="lines" aria-hidden="true">
        <defs>
          <pattern id="hl-fleck" width="3" height="3" patternUnits="userSpaceOnUse">
            <circle cx="0.4" cy="0.7" r="0.05" fill="#b9bdb4" />
            <circle cx="1.9" cy="0.3" r="0.04" fill="#c9ccc4" />
            <circle cx="2.4" cy="2.2" r="0.06" fill="#aeb3a9" />
            <circle cx="1.1" cy="1.9" r="0.035" fill="#9ea398" />
            <circle cx="0.2" cy="2.8" r="0.04" fill="#c4c8bf" />
          </pattern>
        </defs>
        <rect class="hl-fleck" id="fleck" fill="url(#hl-fleck)" />
        <g id="paths"></g>
      </svg>
      <div class="hl-here" id="here"><b>You are here</b><span>Main corridor</span></div>
      <figure class="hl-wait" id="wait">
        <svg viewBox="0 0 6 6" aria-hidden="true">
          <g fill="#f1c232">
            <path d="M1.55 1.1 c0.55 0 0.85 0.6 0.8 1.5 c-0.05 0.9 -0.25 1.5 -0.75 1.5 c-0.5 0 -0.7 -0.6 -0.7 -1.4 c0 -0.9 0.15 -1.6 0.65 -1.6 z M1.65 4.35 c0.4 0 0.55 0.3 0.5 0.7 c-0.05 0.35 -0.25 0.55 -0.55 0.55 c-0.3 0 -0.45 -0.25 -0.45 -0.6 c0 -0.4 0.15 -0.65 0.5 -0.65 z" />
            <path d="M4.45 0.4 c0.55 0 0.85 0.6 0.8 1.5 c-0.05 0.9 -0.25 1.5 -0.75 1.5 c-0.5 0 -0.7 -0.6 -0.7 -1.4 c0 -0.9 0.15 -1.6 0.65 -1.6 z M4.35 3.65 c0.4 0 0.55 0.3 0.5 0.7 c-0.05 0.35 -0.25 0.55 -0.55 0.55 c-0.3 0 -0.45 -0.25 -0.45 -0.6 c0 -0.4 0.15 -0.65 0.5 -0.65 z" />
          </g>
        </svg>
        <figcaption><b>Not sure yet?</b> Stand on the feet. Someone will come and ask which colour you are.</figcaption>
      </figure>
      {WARDS.map((ward, index) => (
        <article class={`hl-door${ward.id === 'out' ? ' hl-exit' : ''}`} data-ward={ward.id} style={`--c: ${ward.colour}; --k: ${ward.ink}`}>
          <h2>{ward.name}</h2>
          <p class="hl-rooms">{ward.rooms}</p>
          <p class="hl-say">{ward.line}</p>
        </article>
      ))}
    </section>

    <nav class="hl-directory" aria-label="Ward directory">
      <h1>Ward F</h1>
      <p class="hl-sub">Feelings and related conditions</p>
      <ul>
        {WARDS.map(ward => (
          <li style={`--c: ${ward.colour}`}>
            <button type="button" data-ward={ward.id}><i aria-hidden="true"></i><span>{ward.name}</span><small>{ward.rooms}</small></button>
          </li>
        ))}
      </ul>
      <p class="hl-rule">Follow your colour on the floor. The lines never cross, so nobody walks into the wrong feeling.</p>
    </nav>
  </main>
</AlignedStudy>

<script>
  import { onSquares, reducedMotion } from '../../../lib/aligned-study';

  type Point = [number, number];
  const svg = document.getElementById('lines') as unknown as SVGSVGElement;
  const group = document.getElementById('paths') as unknown as SVGGElement;
  const fleck = document.getElementById('fleck') as unknown as SVGRectElement;
  const floor = document.getElementById('floor') as HTMLElement;
  const here = document.getElementById('here') as HTMLElement;
  const wait = document.getElementById('wait') as HTMLElement;
  const doors = [...document.querySelectorAll<HTMLElement>('.hl-door')];
  const stage = document.getElementById('hl') as HTMLElement;
  let drawn = false;

  /** An orthogonal polyline as a path whose corners turn on arcs of up to `radius` squares. */
  function rounded(points: Point[], radius: number) {
    let d = `M ${points[0][0]} ${points[0][1]}`;
    let length = 0;
    for (let index = 1; index < points.length; index++) {
      const [x0, y0] = points[index - 1];
      const [x1, y1] = points[index];
      const next = points[index + 1];
      const span = Math.abs(x1 - x0) + Math.abs(y1 - y0);
      length += span;
      if (!next) { d += ` L ${x1} ${y1}`; break; }
      const after = Math.abs(next[0] - x1) + Math.abs(next[1] - y1);
      const r = Math.min(radius, span / 2, after / 2);
      const ix = Math.sign(x1 - x0), iy = Math.sign(y1 - y0);
      const ox = Math.sign(next[0] - x1), oy = Math.sign(next[1] - y1);
      const sweep = ix * oy - iy * ox > 0 ? 1 : 0;
      d += ` L ${x1 - ix * r} ${y1 - iy * r} A ${r} ${r} 0 0 ${sweep} ${x1 + ox * r} ${y1 + oy * r}`;
      length -= r * (2 - Math.PI / 2);
    }
    return { d, length };
  }

  const place = (element: HTMLElement, column: number, columns: number, row: number, rows: number) => {
    element.style.gridColumn = `${column} / span ${columns}`;
    element.style.gridRow = `${row} / span ${rows}`;
  };

  onSquares(({ across, down, narrow }) => {
    const routes: Point[][] = [];
    let high = down;
    if (!narrow) {
      // The directory takes the wall's left; the six doors share the rest of the wall.
      const directory = across >= 70 ? 20 : across >= 56 ? 16 : Math.max(12, Math.floor(across * 0.28));
      stage.style.setProperty('--hl-dir', String(directory));
      const start = directory + 4;
      const wide = Math.floor((across - 1 - start) / 6);
      const top = down - 13; // the bundle's first row, counted from 0
      place(here, 2, 9, top - 1, 9);
      // The feet stand in the floor between the board and the junction, when there is floor to spare.
      const room = top - 2 - 19;
      wait.hidden = room < 6;
      if (!wait.hidden) place(wait, 4, 15, 19 + Math.floor((room - 6) / 2), 6);
      doors.forEach((door, index) => {
        if (index < 6) place(door, start + index * wide, wide - 1, 2, 7);
        else { door.style.gridColumn = '-12 / -2'; door.style.gridRow = '-6 / span 4'; }
      });
      for (let index = 0; index < 7; index++) {
        const y = top + index + 0.5;
        const x = start - 1 + index * wide + Math.floor((wide - 1) / 2) + 0.5;
        if (index === 6) { routes.push([[6, y], [across, y]]); continue; }
        if (index !== 2) { routes.push([[6, y], [x, y], [x, 9]]); continue; }
        // Patience: the same door, by way of every square the floor can spare.
        const left = x - (wide - 2), right = x + (wide - 2);
        const route: Point[] = [[6, y]];
        let row = y, side = right;
        while (row - 2 > 12) {
          route.push([side, row], [side, row - 2]);
          row -= 2;
          side = side === right ? left : right;
        }
        route.push([x, row], [x, 9]);
        routes.push(route);
      }
    } else {
      // A narrow window: the bundle runs down the left and each line turns right to its sign.
      high = 10 + 7 * 8;
      wait.hidden = true;
      place(here, 1, 7, 1, 7);
      doors.forEach((door, index) => place(door, 9, 6, 9 + index * 8, 6));
      for (let index = 0; index < 7; index++) {
        const x = 6 - index + 0.5;
        const y = 9 + index * 8 + 0.5;
        routes.push([[x, 4], [x, y], [8, y]]);
      }
    }

    floor.style.setProperty('--hl-rows', String(high));
    svg.setAttribute('viewBox', `0 0 ${across} ${high}`);
    fleck.setAttribute('width', String(across));
    fleck.setAttribute('height', String(high));

    const animate = !drawn && !reducedMotion();
    group.innerHTML = routes.map((route, index) => {
      const door = doors[index];
      const ward = door.dataset.ward!;
      const name = door.querySelector('h2')!.textContent!;
      const { d, length } = rounded(route, index === 2 && !narrow ? 1 : 2);
      const words = Array.from({ length: Math.ceil(length / (name.length * 0.32 + 2.4)) + 1 }, () => name).join('   ');
      const delay = index * 0.12;
      return `<g class="hl-line" data-ward="${ward}" style="--c:${door.style.getPropertyValue('--c')};--k:${door.style.getPropertyValue('--k')};--delay:${delay}s;--run:${index === 2 ? 2.8 : 1.3}s">
        <path id="hl-route-${ward}" d="${d}" />
        <text dy="0.18"><textPath href="#hl-route-${ward}" startOffset="${narrow ? 4.5 : 5.2}">${words}</textPath></text>
      </g>`;
    }).join('');
    group.querySelectorAll<SVGPathElement>('path').forEach(path => path.style.setProperty('--len', String(path.getTotalLength())));
    stage.toggleAttribute('data-drawing', animate);
    drawn = true;
  });

  // The directory lights one line and its door, and lets the others fade into the linoleum.
  const show = (ward: string | null) => ward ? stage.setAttribute('data-show', ward) : stage.removeAttribute('data-show');
  document.querySelectorAll<HTMLButtonElement>('.hl-directory button').forEach(button => {
    const ward = button.dataset.ward!;
    button.addEventListener('pointerenter', () => show(ward));
    button.addEventListener('pointerleave', () => show(null));
    button.addEventListener('focus', () => show(ward));
    button.addEventListener('blur', () => show(null));
    button.addEventListener('click', () => show(stage.getAttribute('data-show') === ward ? null : ward));
  });
</script>

<style is:global>
  html { background: #eef0eb; }
  .hl {
    --navy: #0f3157;
    --floor: #dfe3dc;
    color: #1e2329;
    font-family: 'Avenir Next', Avenir, var(--typeface-regular), sans-serif;
    font-size: calc(14px * var(--sf));
    line-height: var(--u);
    background: var(--floor);
  }

  .hl-floor {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--across), var(--u));
    grid-template-rows: repeat(var(--hl-rows, var(--down)), var(--u));
  }
  .hl-floor > * { min-width: 0; min-height: 0; }
  .hl-wall { grid-column: 1 / -1; grid-row: 1 / span 9; background: #eef0eb; box-shadow: inset 0 -3px 0 #b8bdb3, inset 0 -4px 0 #8d9389; }
  .hl-lines { grid-column: 1 / -1; grid-row: 1 / -1; width: 100%; height: 100%; overflow: visible; }
  .hl-fleck { y: 9px; }

  .hl-line path { fill: none; stroke: var(--c); stroke-width: 0.78; stroke-linejoin: round; transition: opacity 0.25s ease; }
  .hl-line text { fill: var(--k); font: 600 0.5px 'Avenir Next', Avenir, sans-serif; letter-spacing: 0.02px; transition: opacity 0.25s ease; }
  .hl[data-drawing] .hl-line path { stroke-dasharray: var(--len) var(--len); stroke-dashoffset: var(--len); animation: hl-paint var(--run) cubic-bezier(0.5, 0, 0.2, 1) var(--delay) forwards; }
  .hl[data-drawing] .hl-line text { opacity: 0; animation: hl-show 0.4s ease calc(var(--delay) + var(--run)) forwards; }
  @keyframes hl-paint { to { stroke-dashoffset: 0; } }
  @keyframes hl-show { to { opacity: 1; } }

  .hl-here {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    justify-items: center;
    border-radius: 50%;
    background: #fff;
    box-shadow: inset 0 0 0 calc(var(--u) / 2) var(--navy);
    color: var(--navy);
    text-align: center;
  }
  .hl-here b { font-weight: 700; font-size: calc(16px * var(--sf)); }
  .hl-here span { font-size: calc(11px * var(--sf)); line-height: calc(var(--u) * 0.8); max-width: calc(5 * var(--u)); }

  .hl-wait { position: relative; z-index: 1; display: grid; grid-template-columns: calc(6 * var(--u)) 1fr; gap: var(--u); margin: 0; align-items: center; }
  .hl-wait svg { width: calc(6 * var(--u)); height: calc(6 * var(--u)); }
  .hl-wait figcaption { font-size: calc(12px * var(--sf)); color: #4b5249; }
  .hl-wait b { display: block; color: #1e2329; font-size: calc(14px * var(--sf)); }
  .hl-wait[hidden] { display: none; }

  /* The door plates: navy, a stripe of the line's colour, white words. */
  .hl-door {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: var(--u) calc(2 * var(--u)) var(--u) calc(2 * var(--u));
    align-content: start;
    padding: 0 calc(var(--u) / 2);
    background: var(--navy);
    color: #fff;
    border-top: var(--u) solid var(--c);
    transition: opacity 0.25s ease;
  }
  .hl-door h2 { grid-row: 2; margin: 0; font-weight: 700; font-size: calc(20px * var(--sf)); line-height: calc(2 * var(--u)); letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hl-rooms { grid-row: 3; margin: 0; color: #cfe0f2; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hl-say { grid-row: 4; margin: 0; font-size: calc(12px * var(--sf)); line-height: var(--u); color: #fff; overflow: hidden; }
  .hl-exit { background: #1f7a3e; border-top: 0; grid-template-rows: calc(2 * var(--u)) calc(2 * var(--u)); }
  .hl-exit h2 { grid-row: 1; }
  .hl-exit .hl-rooms { display: none; }
  .hl-exit .hl-say { grid-row: 2; }

  /* The ward directory, a free-standing board on the wall's left. */
  .hl-directory {
    grid-column: 2 / span var(--hl-dir, 20);
    grid-row: 2 / span 17;
    z-index: 2;
    padding: var(--u) var(--u) 0;
    background: var(--navy);
    color: #fff;
    box-shadow: 0 calc(var(--u) / 4) 0 rgba(15, 49, 87, 0.25);
  }
  .hl-directory h1 { margin: 0; font-weight: 700; font-size: calc(52px * var(--sf)); line-height: calc(3 * var(--u)); letter-spacing: -0.02em; }
  .hl-sub { margin: 0 0 var(--u); color: #cfe0f2; }
  .hl-directory ul { margin: 0; padding: 0; list-style: none; }
  .hl-directory button {
    all: unset;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: var(--u) auto 1fr;
    gap: calc(var(--u) / 2);
    width: 100%;
    height: var(--u);
    cursor: pointer;
  }
  .hl-directory button i { width: var(--u); height: var(--u); background: var(--c); }
  .hl-directory button span { font-weight: 600; }
  .hl-directory button small { justify-self: end; font-size: calc(12px * var(--sf)); color: #cfe0f2; font-variant-numeric: tabular-nums; }
  .hl-directory button:hover span, .hl-directory button:focus-visible span { text-decoration: underline; text-underline-offset: calc(3px * var(--sf)); }
  .hl-directory button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .hl-rule { margin: var(--u) 0 0; font-size: calc(12px * var(--sf)); color: #cfe0f2; }

  .hl[data-show='courage'] .hl-line:not([data-ward='courage']) :is(path, text),
  .hl[data-show='relief'] .hl-line:not([data-ward='relief']) :is(path, text),
  .hl[data-show='patience'] .hl-line:not([data-ward='patience']) :is(path, text),
  .hl[data-show='rest'] .hl-line:not([data-ward='rest']) :is(path, text),
  .hl[data-show='laughter'] .hl-line:not([data-ward='laughter']) :is(path, text),
  .hl[data-show='grief'] .hl-line:not([data-ward='grief']) :is(path, text),
  .hl[data-show='out'] .hl-line:not([data-ward='out']) :is(path, text) { opacity: 0.18; }
  .hl[data-show='courage'] .hl-door:not([data-ward='courage']),
  .hl[data-show='relief'] .hl-door:not([data-ward='relief']),
  .hl[data-show='patience'] .hl-door:not([data-ward='patience']),
  .hl[data-show='rest'] .hl-door:not([data-ward='rest']),
  .hl[data-show='laughter'] .hl-door:not([data-ward='laughter']),
  .hl[data-show='grief'] .hl-door:not([data-ward='grief']),
  .hl[data-show='out'] .hl-door:not([data-ward='out']) { opacity: 0.3; }

  /* Narrow: the board first, then the corridor running down the page. */
  :root[data-narrow] .hl { padding-bottom: calc(2 * var(--u)); }
  :root[data-narrow] .hl-directory { grid-column: 2 / -2; grid-row: auto; margin-block: var(--u); padding-bottom: var(--u); }
  :root[data-narrow] .hl-directory h1 { font-size: calc(40px * var(--sf)); }
  :root[data-narrow] .hl-floor { grid-row: auto; order: 2; }
  :root[data-narrow] .hl-wall { display: none; }
  :root[data-narrow] .hl-fleck { y: 0; }
  :root[data-narrow] .hl-door { padding-inline: calc(var(--u) / 2) calc(var(--u) / 4); grid-template-rows: calc(2 * var(--u)) var(--u) calc(3 * var(--u)); border-top: 0; border-left: calc(var(--u) / 2) solid var(--c); }
  :root[data-narrow] .hl-door h2 { grid-row: 1; font-size: calc(18px * var(--sf)); }
  :root[data-narrow] .hl-door .hl-rooms { grid-row: 2; display: block; }
  :root[data-narrow] .hl-door .hl-say { grid-row: 3; white-space: normal; }
  :root[data-narrow] .hl-exit { border-left-color: #1f7a3e; }
</style>
