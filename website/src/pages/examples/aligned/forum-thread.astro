---
// After a bulletin board of the early two-thousands, still running: a banner, a bar of links, the
// breadcrumb, then the thread as rows of posts, the poster's card on the left (rank, pips, avatar,
// post count) and the post on the right, with quotes inside quotes and a signature under a rule.
// The board's logo stands in its own puddle. Every row, card and quote is a whole number of squares.
import AlignedStudy from '../../../layouts/AlignedStudy.astro';

interface Post {
  id: string; user: string; rank: string; pips: number; avatar?: string; posts: string; joined: string; from: string;
  when: string; body: string; sig?: string; mod?: boolean; edited?: string; online?: boolean;
}

const posts: Post[] = [
  {
    id: 'p5402', user: 'heron_of_the_A38', rank: 'Standing Water Elder', pips: 5, avatar: '/examples/images/birdie-heron.jpg', posts: '4,812', joined: 'Mar 2004', from: 'Abbotsbury, mostly', when: 'Thu 12 Nov 2026, 07:41', online: true,
    body: `<p>With respect, the Co-op puddle is a car park puddle. It forms on tarmac, it drains in a day and it has had a shopping trolley in it since August.</p><p>A real puddle needs a clay bottom and a pothole with a history. I give you, again, the layby on the B3157 after Abbotsbury: three weeks of standing water after any proper rain, and at dawn it holds the whole of St Catherine's chapel upside down.</p>`,
    sig: 'Depth is not everything. But it is most things.',
  },
  {
    id: 'p5403', user: 'MrsWellington', rank: 'Splash Marshal', pips: 4, avatar: '/examples/images/birdie-mallard.jpg', posts: '2,209', joined: 'Oct 2007', from: 'Bridport', when: 'Thu 12 Nov 2026, 08:03',
    body: `<blockquote><cite>heron_of_the_A38 wrote:</cite><p>A real puddle needs a clay bottom and a pothole with a history.</p></blockquote><p>Gatekeeping, as ever. A puddle is a puddle the moment a child wants to jump in it.</p><p>Three generations of my family have jumped in the Co-op puddle and it has never once come over the top of a welly, which is the only test that matters. Your layby needs waders and a lay-by permit.</p>`,
    sig: 'Wellies by the door since 1983. Ask me about the Gaol Lane incident (don\'t).',
  },
  {
    id: 'p5404', user: 'Wren', rank: 'Moderator', pips: 6, avatar: '/examples/images/birdie-wren.jpg', posts: '9,330', joined: 'Jan 2003', from: 'The bottom of the garden', when: 'Thu 12 Nov 2026, 08:15', mod: true, online: true,
    body: `<p>A friendly reminder: this is the third thread this year to reach 270 posts on this question. Keep it civil, please.</p><p>And no more photographs of the Abbotsbury layby taken through a car windscreen. We can all see the wipers. Thread stays open.</p>`,
  },
  {
    id: 'p5405', user: 'kingfisher_dave', rank: 'Puddle Surveyor', pips: 4, avatar: '/examples/images/birdie-kingfisher.jpg', posts: '1,377', joined: 'Jun 2011', from: 'Weymouth', when: 'Thu 12 Nov 2026, 09:27',
    body: `<p>Measurements, since nobody else ever brings any.</p><pre><code>             across   deepest   lasted\nCo-op          2.3 m     4 cm     26 h\nB3157 layby    6.1 m    11 cm     19 d</code></pre><p>Across times depth times days, the layby wins by a factor of about 700. I timed the Co-op one myself on 3 October, from a bench, with a flask.</p>`,
    sig: 'Puddle Index v2.1. Ask me about the formula. Actually, I will tell you anyway.',
  },
  {
    id: 'p5406', user: 'damp_newcomer', rank: 'Damp Newcomer', pips: 1, posts: '1', joined: 'Nov 2026', from: '', when: 'Thu 12 Nov 2026, 10:12',
    body: `<p>long time reader, first post. you are all forgetting the one at the bottom of Gaol Lane, which has had tadpoles in it every spring since 2019.</p><p>it is not a puddle any more. it is a habitat. i rest my case</p>`,
  },
  {
    id: 'p5407', user: 'heron_of_the_A38', rank: 'Standing Water Elder', pips: 5, avatar: '/examples/images/birdie-heron.jpg', posts: '4,813', joined: 'Mar 2004', from: 'Abbotsbury, mostly', when: 'Thu 12 Nov 2026, 10:40', online: true,
    body: `<blockquote><cite>kingfisher_dave wrote:</cite><blockquote><cite>MrsWellington wrote:</cite><p>never once come over the top of a welly</p></blockquote><p>Across times depth times days, the layby wins by a factor of about 700.</p></blockquote><p>Thank you, Dave. Finally, some rigour in this place.</p><p>And welcome, damp_newcomer. Gaol Lane is a pond. There is a separate board for ponds. We do not speak of it.</p>`,
    sig: 'Depth is not everything. But it is most things.',
  },
  {
    id: 'p5408', user: 'MrsWellington', rank: 'Splash Marshal', pips: 4, avatar: '/examples/images/birdie-mallard.jpg', posts: '2,210', joined: 'Oct 2007', from: 'Bridport', when: 'Thu 12 Nov 2026, 11:02', edited: 'Last edited by MrsWellington on Thu 12 Nov 2026, 11:09, edited 2 times in total.',
    body: `<p>Dave's formula has no term for joy.</p>`,
    sig: 'Wellies by the door since 1983. Ask me about the Gaol Lane incident (don\'t).',
  },
];

const pages = ['1', '2', '3', '4', '5', '…', '14'];
---
<AlignedStudy slug="forum-thread" theme="light" scroll>
  <main class="stage forum">
    <div class="pb-wrap">
      <header class="pb-banner">
        <a href="#top" class="pb-logo" aria-label="Puddleboard, board index">
          <span class="pb-word">Puddleboard</span>
          <span class="pb-reflection" aria-hidden="true">Puddleboard</span>
          <svg width="0" height="0" aria-hidden="true" style="position: absolute"><filter id="pb-ripple"><feTurbulence type="fractalNoise" baseFrequency="0.01 0.35" numOctaves="1" seed="3" /><feDisplacementMap in="SourceGraphic" scale="5" /></filter></svg>
        </a>
        <p class="pb-tag">The forum for people who look down. Since 2003, over 41,000 posts about water that stays where it is.</p>
        <form class="pb-search" role="search" onsubmit="return false">
          <label for="pb-q" class="pb-sr">Search the board</label>
          <input id="pb-q" type="search" placeholder="Search…" />
          <button type="submit">Go</button>
        </form>
      </header>

      <nav class="pb-bar" aria-label="Board">
        <ul>
          <li><a href="#top">Board index</a></li>
          <li><a href="#top">FAQ</a></li>
          <li><a href="#top">Members</a></li>
          <li><a href="#top">The Puddle of the Month</a></li>
        </ul>
        <ul>
          <li><a href="#top">Register</a></li>
          <li><a href="#top">Log in</a></li>
        </ul>
      </nav>

      <p class="pb-crumbs"><a href="#top">Board index</a> <span aria-hidden="true">»</span> <a href="#top">Outdoors</a> <span aria-hidden="true">»</span> <a href="#top">Puddles, potholes and standing water</a></p>

      <h1 class="pb-title" id="top">The best puddle in Britain is outside the Co-op on Fore Street, Bridport. Discuss.</h1>

      <div class="pb-tools">
        <a href="#pb-reply" class="pb-button">Post a reply</a>
        <span class="pb-meta">271 posts, page 3 of 14</span>
        <nav class="pb-pages" aria-label="Pages">
          {pages.map(p => p === '…' ? <span class="pb-gap">…</span> : <a href="#top" aria-current={p === '3' ? 'page' : undefined}>{p}</a>)}
          <a href="#top" class="pb-next">Next</a>
        </nav>
      </div>

      <div class="pb-posts">
        {posts.map((post, index) => (
          <article class:list={['pb-post', index % 2 ? 'pb-alt' : '', post.mod && 'pb-mod']} id={post.id}>
            <aside class="pb-card">
              <p class="pb-user"><a href={`#${post.id}`}>{post.user}</a>{post.online && <span class="pb-online" title="Online now"><span class="pb-sr">online now</span></span>}</p>
              <p class="pb-rank">{post.rank}</p>
              <p class="pb-pips" aria-label={`${post.pips} drops of six`}>{Array.from({ length: 6 }, (_, i) => <i class:list={[i < post.pips && 'on']}></i>)}</p>
              {post.avatar ? <img class="pb-avatar" src={post.avatar} alt="" width="80" height="80" loading="lazy" /> : <span class="pb-avatar pb-none" aria-hidden="true"></span>}
              <dl>
                <div><dt>Posts</dt><dd>{post.posts}</dd></div>
                <div><dt>Joined</dt><dd>{post.joined}</dd></div>
                {post.from && <div><dt>From</dt><dd>{post.from}</dd></div>}
              </dl>
            </aside>
            <div class="pb-body">
              <header>
                <h2><a href={`#${post.id}`}>Re: The best puddle in Britain is outside the Co-op…</a></h2>
                <p>by <b>{post.user}</b> on {post.when}</p>
                <span class="pb-quote-btn">Quote</span>
              </header>
              <div class="pb-content" set:html={post.body} />
              {post.edited && <p class="pb-edited">{post.edited}</p>}
              {post.sig && <p class="pb-sig">{post.sig}</p>}
            </div>
          </article>
        ))}
      </div>

      <div class="pb-tools">
        <a href="#pb-reply" class="pb-button">Post a reply</a>
        <span class="pb-meta">271 posts, page 3 of 14</span>
        <nav class="pb-pages" aria-label="Pages, again">
          {pages.map(p => p === '…' ? <span class="pb-gap">…</span> : <a href="#top" aria-current={p === '3' ? 'page' : undefined}>{p}</a>)}
          <a href="#top" class="pb-next">Next</a>
        </nav>
      </div>

      <form class="pb-reply" id="pb-reply" onsubmit="return false">
        <h2>Quick reply</h2>
        <label for="pb-text" class="pb-sr">Your reply</label>
        <textarea id="pb-text" rows="4" placeholder="Log in to say which puddle is best. Be kind; Wren is watching."></textarea>
        <button type="submit" disabled>Submit reply</button>
      </form>

      <section class="pb-online-box">
        <h2>Who is online</h2>
        <p>In total there are 44 users online: 3 registered and 41 guests, most of them from a search for “is it legal to fill in a pothole yourself”.</p>
        <p>Browsing this topic: <b>heron_of_the_A38</b>, <b class="pb-modname">Wren</b> and 41 guests.</p>
      </section>

      <footer class="pb-foot">Driftwood BB 2.0.23. The board is run by volunteers and one very old server in a damp cupboard.</footer>
    </div>
  </main>
</AlignedStudy>

<script>
  import { onSquares } from '../../../lib/aligned-study';
  // The board grows with its posts; its height is rounded up to whole squares, so the page ends on a line.
  const wrap = document.querySelector<HTMLElement>('.pb-wrap')!;
  let unit = 20;
  const round = () => {
    wrap.style.minHeight = '';
    wrap.style.minHeight = `${Math.ceil(wrap.getBoundingClientRect().height / unit - 0.01) * unit}px`;
  };
  onSquares(squares => { unit = squares.unit; round(); });
  new ResizeObserver(() => { if (!wrap.style.minHeight) return; const h = wrap.getBoundingClientRect().height; if (Math.abs(h / unit - Math.round(h / unit)) > 0.01) round(); }).observe(wrap);
</script>

<style is:global>
  html[data-study='forum-thread'] { background: #d4dde6; }
  .forum {
    --page: #d4dde6;
    --panel: #ffffff;
    --row: #e6eef5;
    --row-alt: #d9e5ef;
    --deep: #0f4a6e;
    --link: #105289;
    --text: #29323a;
    --muted: #5e6b77;
    --quote: #eeefe2;
    --rule: #b9c9d8;
    grid-template-rows: none !important;
    grid-auto-rows: min-content;
    height: auto !important;
    min-height: var(--high);
    padding-block: var(--u) calc(3 * var(--u));
    box-sizing: border-box;
    background: var(--page);
    color: var(--text);
    font-family: Verdana, Geneva, var(--typeface-regular);
    font-size: calc(12px * var(--sf));
    line-height: var(--u);
  }
  .forum p, .forum h1, .forum h2, .forum ul, .forum dl, .forum dd, .forum blockquote, .forum pre { margin: 0; }
  .forum a { color: var(--link); text-decoration: none; }
  .forum a:hover { text-decoration: underline; color: #d31141; }
  .forum a:focus-visible, .forum button:focus-visible, .forum input:focus-visible, .forum textarea:focus-visible { outline: 2px solid #d31141; outline-offset: 1px; }
  .pb-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* The board: a white panel, three squares in from the window on a computer, every block a square apart. */
  .pb-wrap { grid-column: 3 / -3; grid-row: 1; align-self: start; background: var(--panel); padding: var(--u); display: grid; grid-template-columns: minmax(0, 1fr); grid-auto-rows: min-content; row-gap: var(--u); align-content: start; box-shadow: 0 0 0 1px var(--rule); border-radius: calc(var(--u) / 2); }

  /* The banner: the board's name standing in its own puddle. */
  .pb-banner {
    display: grid;
    grid-template-columns: calc(18 * var(--u)) 1fr calc(12 * var(--u));
    column-gap: var(--u);
    height: calc(6 * var(--u));
    padding-inline: var(--u);
    align-items: center;
    border-radius: calc(var(--u) / 2);
    background: linear-gradient(to bottom, #1b6f9e, var(--deep) 60%, #0a3654);
    color: #fff;
  }
  .forum .pb-logo { position: relative; display: block; height: calc(4 * var(--u)); color: #fff; text-decoration: none; }
  .pb-word, .pb-reflection { position: absolute; left: 0; font: bold calc(34px * var(--sf)) / calc(2 * var(--u)) 'Trebuchet MS', var(--typeface-medium); letter-spacing: -0.02em; white-space: nowrap; }
  .pb-word { top: 0; text-shadow: 0 2px 0 rgb(0 0 0 / 0.25); }
  .pb-reflection {
    top: calc(2 * var(--u));
    transform: scaleY(-1);
    color: #9fd3f0;
    opacity: 0.75;
    /* The puddle: an oval of water the reflection only shows inside, rippled every fifth of a square. */
    -webkit-mask: radial-gradient(ellipse 50% 60% at 50% 45%, #000 55%, transparent 100%), repeating-linear-gradient(to bottom, #000 0 3px, rgb(0 0 0 / 0.3) 3px 5px);
    mask: radial-gradient(ellipse 50% 60% at 50% 45%, #000 55%, transparent 100%), repeating-linear-gradient(to bottom, #000 0 3px, rgb(0 0 0 / 0.3) 3px 5px);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    filter: url(#pb-ripple);
  }
  /* The puddle itself, a flat oval of lighter water under the word. */
  .forum .pb-logo::before { content: ''; position: absolute; left: -6%; right: 32%; top: calc(2 * var(--u) - 4px); height: calc(2 * var(--u)); border-radius: 50%; background: radial-gradient(ellipse at 50% 40%, rgb(159 211 240 / 0.3), rgb(159 211 240 / 0.08) 60%, transparent 72%); }
  .pb-tag { color: #d6ebf7; max-width: 34em; }
  .pb-search { display: grid; grid-template-columns: 1fr calc(2 * var(--u)); height: var(--u); }
  .pb-search input { all: unset; background: #fff; color: var(--text); padding-inline: calc(var(--u) / 4); font: inherit; height: var(--u); border-radius: 3px 0 0 3px; box-sizing: border-box; min-width: 0; }
  .pb-search button { all: unset; background: #e8eef3; color: var(--deep); text-align: center; font: inherit; height: var(--u); border-radius: 0 3px 3px 0; cursor: pointer; }

  .pb-bar { display: flex; justify-content: space-between; height: var(--u); padding-inline: var(--u); background: var(--row); border-radius: calc(var(--u) / 4); }
  .pb-bar ul { display: flex; column-gap: var(--u); list-style: none; padding: 0; }
  .pb-crumbs { font-weight: bold; }
  .pb-crumbs span { color: var(--muted); font-weight: normal; }
  .pb-title { font: bold calc(20px * var(--sf)) / calc(2 * var(--u)) 'Trebuchet MS', var(--typeface-medium); color: var(--deep); }

  .pb-tools { display: flex; align-items: center; column-gap: var(--u); height: var(--u); }
  .forum .pb-button { display: block; height: var(--u); padding-inline: calc(var(--u) / 2); background: linear-gradient(#fff, #e3ebf1); box-shadow: inset 0 0 0 1px #9fb4c6; border-radius: 4px; font-weight: bold; color: var(--deep); }
  .pb-meta { margin-left: auto; color: var(--muted); }
  .pb-pages { display: flex; column-gap: 2px; }
  .pb-pages a, .pb-gap { display: block; min-width: var(--u); padding-inline: 3px; height: var(--u); text-align: center; box-sizing: border-box; }
  .pb-pages a { box-shadow: inset 0 0 0 1px var(--rule); border-radius: 3px; }
  .forum .pb-pages a[aria-current='page'] { background: var(--deep); color: #fff; box-shadow: none; }

  /* A post: the poster's card in ten squares, the post beside it; rows alternate their blue. */
  .pb-posts { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--u); }
  .pb-post { display: grid; grid-template-columns: calc(10 * var(--u)) 1fr; column-gap: var(--u); padding: var(--u); background: var(--row); border-radius: calc(var(--u) / 2); }
  .pb-alt { background: var(--row-alt); }
  .pb-mod { background: #e3f0e1; box-shadow: inset 0 0 0 1px #9fc79a; }
  .pb-card { box-shadow: inset -1px 0 0 #fff; padding-right: var(--u); }
  .pb-user { font-weight: bold; font-size: calc(13px * var(--sf)); display: flex; align-items: center; column-gap: calc(var(--u) / 4); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pb-mod .pb-user a, .pb-modname { color: #2b7a1d !important; }
  .pb-online { width: calc(var(--u) / 2.5); height: calc(var(--u) / 2.5); border-radius: 50%; background: #3fb63a; box-shadow: 0 0 0 2px #fff; flex: none; }
  .pb-rank { color: var(--muted); font-style: italic; }
  .pb-pips { display: flex; column-gap: 2px; height: var(--u); align-items: center; }
  .pb-pips i { width: calc(var(--u) / 2.5); height: calc(var(--u) / 2.5); border-radius: 50% 0 50% 50%; transform: rotate(-45deg); background: #c3d0dc; }
  .pb-pips i.on { background: linear-gradient(135deg, #8ad3ff, #1b6f9e); }
  .pb-mod .pb-pips i.on { background: linear-gradient(135deg, #b6e6a6, #2b7a1d); }
  .pb-avatar { display: block; width: calc(4 * var(--u)); height: calc(4 * var(--u)); object-fit: cover; margin-block: var(--u); border-radius: 3px; box-shadow: 0 0 0 1px #fff, 0 0 0 2px var(--rule); }
  .pb-none { background: radial-gradient(circle at 50% 38%, #aebdcb 22%, transparent 23%), radial-gradient(ellipse 60% 45% at 50% 100%, #aebdcb 70%, transparent 71%), #dfe7ee; }
  .pb-card dl div { display: grid; grid-template-columns: calc(3 * var(--u)) 1fr; }
  .pb-card dt { font-weight: bold; }
  .pb-card dd { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .pb-body header { display: grid; grid-template-columns: 1fr auto; padding-bottom: var(--u); margin-bottom: var(--u); box-shadow: inset 0 -1px 0 #fff; }
  .pb-body h2 { font: bold calc(13px * var(--sf)) / var(--u) 'Trebuchet MS', var(--typeface-medium); grid-column: 1; }
  .pb-body header p { grid-column: 1; color: var(--muted); font-size: calc(11px * var(--sf)); }
  .pb-quote-btn { grid-column: 2; grid-row: 1 / span 2; align-self: center; height: var(--u); padding-inline: calc(var(--u) / 2); box-shadow: inset 0 0 0 1px #9fb4c6; border-radius: 4px; background: #fff; color: var(--muted); font-size: calc(11px * var(--sf)); }
  .pb-content { max-width: 46em; font-size: calc(13px * var(--sf)); }
  .pb-content p + p, .pb-content blockquote + p, .pb-content pre + p, .pb-content p + pre { margin-top: var(--u); }
  .pb-content blockquote { margin-bottom: var(--u); padding: var(--u); background: var(--quote); box-shadow: inset 0 0 0 1px #d8d8c4; border-radius: 3px; font-size: calc(12px * var(--sf)); }
  .pb-content blockquote blockquote { background: #f8f8ef; }
  .pb-content cite { display: block; font-style: normal; font-weight: bold; }
  .pb-content pre { padding: var(--u); background: #fafafa; box-shadow: inset 0 0 0 1px var(--rule); font: calc(12px * var(--sf)) / var(--u) 'Courier New', monospace; overflow-x: auto; }
  .pb-edited { margin-top: var(--u); color: var(--muted); font-size: calc(11px * var(--sf)); font-style: italic; }
  .pb-sig { margin-top: var(--u); padding-top: var(--u); box-shadow: inset 0 1px 0 var(--rule); width: calc(20 * var(--u)); max-width: 100%; color: var(--muted); font-size: calc(11px * var(--sf)); }

  .pb-reply { display: grid; row-gap: var(--u); padding: var(--u); background: var(--row); border-radius: calc(var(--u) / 2); }
  .pb-reply h2, .pb-online-box h2 { font: bold calc(13px * var(--sf)) / var(--u) 'Trebuchet MS', var(--typeface-medium); color: var(--deep); }
  .pb-reply textarea { all: unset; height: calc(4 * var(--u)); background: #fff; box-shadow: inset 0 0 0 1px #9fb4c6; padding: 0 calc(var(--u) / 4); font: calc(12px * var(--sf)) / var(--u) Verdana, Geneva, sans-serif; white-space: pre-wrap; box-sizing: border-box; }
  .pb-reply button { all: unset; justify-self: start; height: var(--u); padding-inline: calc(var(--u) / 2); background: #e3ebf1; box-shadow: inset 0 0 0 1px #9fb4c6; border-radius: 4px; color: var(--muted); }
  .pb-online-box { color: var(--muted); }
  .pb-foot { color: var(--muted); font-size: calc(11px * var(--sf)); text-align: center; }

  :root[data-narrow] .pb-wrap { grid-column: 1 / -1; border-radius: 0; padding-inline: calc(var(--u) / 2); }
  :root[data-narrow] .pb-banner { grid-template-columns: minmax(0, 1fr); height: auto; padding-block: var(--u); row-gap: var(--u); }
  :root[data-narrow] .pb-search { display: none; }
  :root[data-narrow] .pb-bar { height: auto; flex-wrap: wrap; }
  :root[data-narrow] .pb-bar ul { flex-wrap: wrap; }
  :root[data-narrow] .pb-tools { flex-wrap: wrap; height: auto; row-gap: var(--u); }
  :root[data-narrow] .pb-meta { margin-left: 0; }
  :root[data-narrow] .pb-post { grid-template-columns: minmax(0, 1fr); padding: calc(var(--u) / 2); }
  :root[data-narrow] .pb-card { display: grid; grid-template-columns: calc(3 * var(--u)) 1fr; column-gap: calc(var(--u) / 2); box-shadow: inset 0 -1px 0 #fff; padding: 0 0 calc(var(--u) / 2); margin-bottom: calc(var(--u) / 2); }
  :root[data-narrow] .pb-card > :not(.pb-avatar) { grid-column: 2; }
  :root[data-narrow] .pb-avatar { grid-column: 1; grid-row: 1 / span 3; width: calc(3 * var(--u)); height: calc(3 * var(--u)); margin: 0; }
  :root[data-narrow] .pb-card dl { display: none; }
  :root[data-narrow] .pb-body header { grid-template-columns: 1fr; }
  :root[data-narrow] .pb-quote-btn { display: none; }
  :root[data-narrow] .pb-content pre { font-size: calc(9px * var(--sf)); }
</style>
