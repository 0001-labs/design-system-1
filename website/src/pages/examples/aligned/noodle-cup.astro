---
// After the lid of an instant noodle cup, seen from above: the round lid as many squares across as
// the window allows, its steps printed round the band, a bowl drawn in the middle and a pull tab
// at the edge. The rim is the timer: thirty-six marks of five seconds each, three minutes in all.
import AlignedStudy from '../../../layouts/AlignedStudy.astro';
---
<AlignedStudy slug="noodle-cup" theme="light">
  <main class="stage noodle">
    <svg class="nd-wave" id="wave" aria-hidden="true"></svg>

    <figure class="nd-lid" id="lid-box">
      <svg id="lid" role="img" aria-label="The lid: a bowl of chicken shoyu ramen, the steps printed round its band, a pull tab at the edge"></svg>
    </figure>

    <header class="nd-head">
      <p class="nd-brand" lang="ja">ほかほか</p>
      <h1>Hoka Hoka chicken shoyu ramen <span lang="ja">鶏しょうゆラーメン</span></h1>
      <p class="nd-sub">With spring onion, naruto and a soft egg. 78 g, one cup.</p>
    </header>

    <ol class="nd-steps">
      <li>
        <svg viewBox="0 0 3 3" aria-hidden="true"><path d="M 0.6 1 L 2.4 1 L 2.1 2.6 L 0.9 2.6 Z" class="nd-i-cup"/><path d="M 0.5 0.9 Q 1.4 0.1 2.5 0.5" class="nd-i-line"/><path d="M 1.6 0.4 L 2.5 0.5 L 2.2 1" class="nd-i-line"/></svg>
        <p><span lang="ja">フタを点線まではがす</span>Peel the lid back to the dotted line.</p>
      </li>
      <li>
        <svg viewBox="0 0 3 3" aria-hidden="true"><path d="M 0.6 1.3 L 2.4 1.3 L 2.1 2.6 L 0.9 2.6 Z" class="nd-i-cup"/><path d="M 0.75 1.8 L 2.25 1.8" class="nd-i-water"/><path d="M 1.5 0.2 L 1.5 1.6" class="nd-i-water"/></svg>
        <p><span lang="ja">熱湯を内側の線まで注ぐ</span>Pour boiling water to the inner line, 310 ml.</p>
      </li>
      <li>
        <svg viewBox="0 0 3 3" aria-hidden="true"><circle cx="1.5" cy="1.6" r="1.1" class="nd-i-cup"/><path d="M 1.5 1.6 L 1.5 0.85 M 1.5 1.6 L 2.05 1.6" class="nd-i-line"/></svg>
        <p><span lang="ja">フタをして3分待つ</span>Close the lid, wait three minutes, stir.</p>
      </li>
    </ol>

    <section class="nd-timer" aria-label="Three-minute timer">
      <p class="nd-digits" id="digits">3:00</p>
      <button type="button" class="nd-go" id="go"><span lang="ja">お湯を注いだら押す</span>Poured: start the timer</button>
      <p class="nd-status" id="status" aria-live="polite">The rim keeps time: one mark every five seconds.</p>
    </section>

    <dl class="nd-facts">
      <div class="nd-facts-head"><dt lang="ja">栄養成分表示</dt><dd>per cup, 78 g</dd></div>
      <div><dt>Energy</dt><dd>352 kcal</dd></div>
      <div><dt>Protein</dt><dd>9.8 g</dd></div>
      <div><dt>Fat</dt><dd>14.6 g</dd></div>
      <div><dt>Carbohydrate</dt><dd>46.4 g</dd></div>
      <div><dt>Salt</dt><dd>5.1 g, of which soup 3.0</dd></div>
    </dl>
    <p class="nd-small">Hot water scalds: hold the cup by its rim, and never in a microwave. Best before 2027.05.14.</p>
  </main>
</AlignedStudy>

<script>
  import { onSquares, reducedMotion } from '../../../lib/aligned-study';

  const MARKS = 36;
  const SECONDS = 180;
  const wave = document.getElementById('wave') as unknown as SVGSVGElement;
  const lid = document.getElementById('lid') as unknown as SVGSVGElement;
  const lidBox = document.getElementById('lid-box')!;
  const f = (n: number) => +n.toFixed(3);

  // The cup's wrap: waves of seigaiha, two squares a fan, half a square a row.
  const fan = (x: number, y: number) =>
    `<g transform="translate(${x} ${y})"><circle r="1" fill="#ffc81e"/><circle r="0.95" class="w"/><circle r="0.7" class="w"/><circle r="0.45" class="w"/><circle r="0.2" class="w"/></g>`;
  const tile = [[1, -0.5], [0, 0], [2, 0], [1, 0.5], [0, 1], [2, 1], [1, 1.5]].map(([x, y]) => fan(x, y)).join('');

  const arc = (cx: number, cy: number, r: number, a0: number, a1: number) => {
    const p = (a: number) => `${f(cx + r * Math.cos(a))} ${f(cy + r * Math.sin(a))}`;
    return `M ${p(a0)} A ${r} ${r} 0 ${a1 - a0 > Math.PI ? 1 : 0} 1 ${p(a1)}`;
  };

  function bowl(c: number, r: number) {
    // Broth, noodles in loose waves, then what sits on top.
    let out = `<circle cx="${c}" cy="${c}" r="${r + 0.5}" fill="#fff" stroke="#d3201b" stroke-width="0.3"/>`;
    out += `<circle cx="${c}" cy="${c}" r="${r}" fill="#b86a2b"/>`;
    for (let k = 0; k < 9; k++) {
      const rr = r * (0.25 + k * 0.085);
      let d = '';
      for (let a = 0; a <= 360; a += 6) {
        const t = (a * Math.PI) / 180;
        const w = rr + Math.sin(t * 9 + k) * r * 0.025;
        d += `${a ? 'L' : 'M'} ${f(c + w * Math.cos(t))} ${f(c + w * Math.sin(t))} `;
      }
      out += `<path d="${d}Z" fill="none" stroke="#f2cf72" stroke-width="${f(r * 0.045)}"/>`;
    }
    // Nori standing at the back.
    out += `<rect x="${f(c + r * 0.15)}" y="${f(c - r * 0.95)}" width="${f(r * 0.5)}" height="${f(r * 0.75)}" fill="#1f2a1d" transform="rotate(18 ${c} ${c})"/>`;
    // Chashu, two slices.
    for (const [dx, dy] of [[-0.42, -0.3], [-0.12, -0.5]]) {
      out += `<circle cx="${f(c + dx * r)}" cy="${f(c + dy * r)}" r="${f(r * 0.27)}" fill="#e0a07a" stroke="#8a4a2c" stroke-width="${f(r * 0.05)}"/>`;
    }
    // Half an egg, twice.
    for (const [dx, dy, rot] of [[0.38, 0.22, -20], [0.12, 0.5, 30]]) {
      const x = c + dx * r, y = c + dy * r;
      out += `<g transform="rotate(${rot} ${f(x)} ${f(y)})"><ellipse cx="${f(x)}" cy="${f(y)}" rx="${f(r * 0.24)}" ry="${f(r * 0.18)}" fill="#fffaf0"/><ellipse cx="${f(x)}" cy="${f(y)}" rx="${f(r * 0.13)}" ry="${f(r * 0.1)}" fill="#f29a12"/></g>`;
    }
    // Naruto: a white disc, its pink spiral and the serrated rim.
    const nx = c - r * 0.35, ny = c + r * 0.35, nr = r * 0.22;
    let spiral = '';
    for (let a = 0; a < 720; a += 10) {
      const t = (a * Math.PI) / 180, rr = (nr * 0.75 * a) / 720;
      spiral += `${a ? 'L' : 'M'} ${f(nx + rr * Math.cos(t))} ${f(ny + rr * Math.sin(t))} `;
    }
    let teeth = '';
    for (let a = 0; a < 360; a += 20) {
      const t = (a * Math.PI) / 180, u = ((a + 10) * Math.PI) / 180;
      teeth += `${a ? 'L' : 'M'} ${f(nx + nr * Math.cos(t))} ${f(ny + nr * Math.sin(t))} L ${f(nx + nr * 0.88 * Math.cos(u))} ${f(ny + nr * 0.88 * Math.sin(u))} `;
    }
    out += `<path d="${teeth}Z" fill="#fff"/><path d="${spiral}" fill="none" stroke="#e8558f" stroke-width="${f(r * 0.04)}"/>`;
    // Spring onion rings, scattered on whole fractions of the bowl.
    const ONION = [[0.05, 0.05], [0.2, -0.05], [-0.05, 0.2], [0.55, -0.15], [0.62, 0.0], [-0.6, 0.05], [-0.15, 0.72], [0.3, -0.25], [0.0, -0.18], [-0.25, 0.05]];
    for (const [dx, dy] of ONION) out += `<circle cx="${f(c + dx * r)}" cy="${f(c + dy * r)}" r="${f(r * 0.05)}" fill="none" stroke="#5aa832" stroke-width="${f(r * 0.03)}"/>`;
    return out;
  }

  let ticks: SVGPathElement[] = [];
  const digits = document.getElementById('digits')!;
  const go = document.getElementById('go') as HTMLButtonElement;
  const status = document.getElementById('status')!;
  const main = document.querySelector<HTMLElement>('.noodle')!;
  let started = 0;
  let frame = 0;
  let left = SECONDS;
  onSquares(({ across, down, narrow }) => {
    const tall = narrow ? 200 : down;
    wave.setAttribute('viewBox', `0 0 ${across} ${tall}`);
    wave.setAttribute('preserveAspectRatio', 'xMinYMin slice');
    wave.innerHTML = `<defs><pattern id="nd-sei" width="2" height="1" patternUnits="userSpaceOnUse">${tile}</pattern></defs><rect width="${across}" height="${tall}" fill="url(#nd-sei)"/>`;

    let D = narrow ? across - 2 : Math.min(down - 6, across - 36);
    D = Math.max(10, D - (D % 2));
    lidBox.style.setProperty('--d', String(D));
    lidBox.style.setProperty('--top', String(narrow ? 1 : Math.max(2, Math.floor((down - D) / 2))));
    const c = D / 2, R = c - (narrow ? 0.3 : 0.5);
    // Rim, band and centre in proportion, so a phone's small lid keeps its bowl.
    const tick = narrow ? 0.45 : 0.6, band = R - tick - 0.4, inner = band - (narrow ? 1.5 : 2.5);
    const ring = (band + inner) / 2 - (narrow ? 0.18 : 0.25);
    lid.setAttribute('viewBox', `0 0 ${D} ${D}`);
    lidBox.style.setProperty('--tick', String(tick));

    // The rim: thirty-six marks, each a tenth of a circle less a gap.
    let rim = '';
    for (let k = 0; k < MARKS; k++) {
      const a0 = -Math.PI / 2 + (k * 2 * Math.PI) / MARKS + 0.02, a1 = a0 + (2 * Math.PI) / MARKS - 0.04;
      rim += `<path class="nd-tick" d="${arc(c, c, R - tick / 2 - 0.1, a0, a1)}"/>`;
    }
    const words = 'フタを点線まではがし、熱湯を内側の線まで注いで3分。Peel to the dotted line, fill to the inner line with boiling water, wait three minutes, stir and eat. ';
    const textPath = `M ${c} ${c - ring} A ${ring} ${ring} 0 1 1 ${c - 0.001} ${c - ring}`;
    const fs = narrow ? 0.5 : 0.72;
    const repeat = 1;
    const tab = (() => {
      const a = Math.PI / 4, x = c + R * Math.cos(a), y = c + R * Math.sin(a), k = narrow ? 0.6 : 1;
      return `<g transform="rotate(-45 ${f(x)} ${f(y)}) translate(${f(x)} ${f(y)}) scale(${k})"><path d="M -1.5 -0.5 L -1.5 1.2 Q -1.5 2.2 -0.5 2.2 L 0.5 2.2 Q 1.5 2.2 1.5 1.2 L 1.5 -0.5 Z" fill="#fff" stroke="#c9c9c9" stroke-width="0.06"/><text x="0" y="1.5" class="nd-tab" text-anchor="middle">はがし口</text></g>`;
    })();
    const dotted = arc(c, c, inner - 0.2, Math.PI * 1.08, Math.PI * 1.92);
    const brand = Math.max(narrow ? 0.9 : 1, Math.min(2.6, inner * 0.5 - (narrow ? 1.2 : 2.8)));
    lid.innerHTML = `
      ${tab}
      <circle cx="${c}" cy="${c}" r="${R}" fill="#f4f4f1" stroke="#cfcfca" stroke-width="0.08"/>
      ${rim}
      <circle cx="${c}" cy="${c}" r="${band}" fill="#d3201b"/>
      <path id="nd-ring" d="${textPath}" fill="none"/>
      <text class="nd-round" style="font-size:${fs}px"><textPath href="#nd-ring">${words.repeat(repeat)}</textPath></text>
      <circle cx="${c}" cy="${c}" r="${inner}" fill="#fffdf6"/>
      <path d="${dotted}" fill="none" stroke="#d3201b" stroke-width="0.1" stroke-dasharray="0.3 0.25"/>
      ${narrow ? '' : `<text class="nd-cut" x="${c}" y="${f(c - inner + 1.6)}" text-anchor="middle">ここまで open to here</text>`}
      ${narrow ? '' : `<text class="nd-kana" x="${c}" y="${f(c - inner * 0.5 - 0.9)}" text-anchor="middle" style="font-size:${f(brand)}px">ほかほか</text>`}
      ${bowl(c, inner * 0.5)}
      <text class="nd-flavour" x="${c}" y="${f(c + inner * 0.78)}" text-anchor="middle" style="font-size:${f(Math.min(1.1, inner * 0.09))}px">鶏しょうゆ</text>`;
    // Fit the printed words to the band: as many copies as read at this size, the size then eased so they close the ring.
    const round = lid.querySelector<SVGTextElement>('.nd-round')!;
    const one = round.getComputedTextLength();
    if (one > 0) {
      const circ = 2 * Math.PI * ring - 0.3;
      const copies = Math.max(1, Math.round(circ / one));
      round.querySelector('textPath')!.textContent = words.repeat(copies);
      round.style.fontSize = `${f((0.97 * fs * circ) / (copies * one))}px`;
    }
    ticks = [...lid.querySelectorAll<SVGPathElement>('.nd-tick')];
    paint();
  });

  // The timer: one mark lights every five seconds; the digits count down beside the lid.

  function paint() {
    const done = SECONDS - left;
    ticks.forEach((tick, k) => tick.classList.toggle('nd-on', done >= (k + 1) * (SECONDS / MARKS)));
    digits.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
  }
  function run() {
    left = Math.max(0, SECONDS - Math.floor((performance.now() - started) / 1000));
    paint();
    if (left === 0) {
      main.toggleAttribute('data-ready', true);
      if (!reducedMotion()) main.toggleAttribute('data-steam', true);
      status.textContent = 'できあがり. Ready: lift the lid, stir well and eat while it is hot.';
      go.innerHTML = '<span lang="ja">もう一杯</span>Another cup';
      started = 0;
      return;
    }
    frame = requestAnimationFrame(run);
  }
  go.addEventListener('click', () => {
    cancelAnimationFrame(frame);
    main.removeAttribute('data-ready');
    main.removeAttribute('data-steam');
    if (started) {
      started = 0;
      left = SECONDS;
      paint();
      status.textContent = 'Stopped. The rim keeps time: one mark every five seconds.';
      go.innerHTML = '<span lang="ja">お湯を注いだら押す</span>Poured: start the timer';
      return;
    }
    started = performance.now();
    left = SECONDS;
    status.textContent = 'Lid closed. Don’t peek: steam is part of the recipe.';
    go.innerHTML = '<span lang="ja">やめる</span>Stop and reset';
    run();
  });
</script>

<style is:global>
  html { background: #ffc81e; }
  .noodle {
    --red: #d3201b;
    --ink: #1b1b1b;
    color: var(--ink);
    background: #ffc81e;
    font-family: 'Avenir Next', 'Hiragino Sans', sans-serif;
    font-size: calc(14px * var(--sf));
    line-height: var(--u);
  }
  .noodle [lang='ja'] { font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', sans-serif; }
  .noodle :is(h1, p, ol, dl, dd) { margin: 0; }

  .nd-wave { grid-column: 1 / -1; grid-row: 1 / -1; width: 100%; height: 100%; }
  .nd-wave .w { fill: none; stroke: #f1b100; stroke-width: 0.06; }

  .nd-lid { grid-column: 4 / span var(--d, 36); grid-row: var(--top, 3) / span var(--d, 36); margin: 0; position: relative; }
  .nd-lid svg { display: block; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(calc(6px * var(--sf)) calc(8px * var(--sf)) 0 rgb(120 60 0 / 0.25)); }
  .nd-tick { fill: none; stroke: #cfcfca; stroke-width: calc(var(--tick, 0.6) * 1px); transition: stroke 300ms; }
  .nd-tick.nd-on { stroke: var(--red); }
  .nd-round { font-family: 'Hiragino Sans', sans-serif; font-weight: 600; fill: #fff; letter-spacing: 0.02em; }
  .nd-kana { font-family: 'Hiragino Sans', sans-serif; font-weight: 800; fill: var(--red); letter-spacing: -0.04em; }
  .nd-flavour { font: 700 1.1px 'Hiragino Mincho ProN', serif; fill: var(--ink); letter-spacing: 0.3em; }
  .nd-cut { font: 600 0.5px 'Hiragino Sans', sans-serif; fill: var(--red); }
  .nd-tab { font: 600 0.5px 'Hiragino Sans', sans-serif; fill: var(--red); }

  .nd-head { grid-column: -31 / -3; grid-row: 3 / span 8; position: relative; }
  .nd-brand { font: 800 calc(56px * var(--sf)) / calc(4 * var(--u)) 'Hiragino Sans', sans-serif; color: var(--red); letter-spacing: -0.05em; }
  .nd-head h1 { font: 700 calc(22px * var(--sf)) / calc(2 * var(--u)) 'Avenir Next', sans-serif; letter-spacing: -0.01em; }
  .nd-head h1 span { display: block; font-size: calc(16px * var(--sf)); line-height: var(--u); font-weight: 600; }
  .nd-sub { color: #5a3d00; background: #ffc81e; width: max-content; max-width: 100%; }

  .nd-steps { grid-column: -31 / -3; grid-row: 12 / span 9; padding: 0; list-style: none; display: grid; grid-template-rows: repeat(3, calc(3 * var(--u))); position: relative; }
  .nd-steps li { display: grid; grid-template-columns: calc(3 * var(--u)) var(--u) calc(2 * var(--u)) 1fr; align-items: center; counter-increment: step; }
  .nd-steps li::after { content: counter(step); grid-column: 3; grid-row: 1; font: 800 calc(30px * var(--sf)) / calc(2 * var(--u)) 'Avenir Next', sans-serif; color: var(--red); }
  .nd-steps svg { grid-column: 1; grid-row: 1; width: calc(3 * var(--u)); height: calc(3 * var(--u)); background: #fff; }
  .nd-steps p { grid-column: 4; grid-row: 1; }
  .nd-steps p span { display: block; font-weight: 600; }
  .nd-i-cup { fill: #fff; stroke: var(--ink); stroke-width: 0.12; stroke-linejoin: round; }
  .nd-i-line { fill: none; stroke: var(--red); stroke-width: 0.14; stroke-linecap: round; stroke-linejoin: round; }
  .nd-i-water { fill: none; stroke: #2a7bd6; stroke-width: 0.14; stroke-linecap: round; }

  .nd-timer { grid-column: -31 / -3; grid-row: 22 / span 7; display: grid; grid-template-columns: calc(11 * var(--u)) var(--u) 1fr; grid-template-rows: repeat(4, var(--u)) var(--u) calc(2 * var(--u)); position: relative; }
  .nd-digits { grid-column: 1; grid-row: 1 / span 4; font: 800 calc(84px * var(--sf)) / calc(4 * var(--u)) 'Avenir Next', sans-serif; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }
  .nd-go { grid-column: 3; grid-row: 1 / span 3; align-self: start; display: grid; align-content: center; height: calc(3 * var(--u)); padding: 0 var(--u); border: 0; border-radius: calc(1.5 * var(--u)); background: var(--red); color: #fff; font: 700 calc(14px * var(--sf)) / var(--u) 'Avenir Next', sans-serif; text-align: left; cursor: pointer; box-shadow: 0 calc(4px * var(--sf)) 0 #8d1210; }
  .nd-go span { font-size: calc(12px * var(--sf)); font-weight: 600; }
  .nd-go:active { transform: translateY(calc(3px * var(--sf))); box-shadow: 0 calc(1px * var(--sf)) 0 #8d1210; }
  .nd-go:focus-visible { outline: 3px solid var(--ink); outline-offset: calc(3px * var(--sf)); }
  .nd-status { grid-column: 1 / -1; grid-row: 6 / span 2; align-self: start; color: #5a3d00; background: #ffc81e; width: max-content; max-width: 100%; }
  .noodle[data-ready] .nd-digits { color: var(--red); }

  .nd-facts { grid-column: -31 / -3; grid-row: -10 / span 6; font-size: calc(12px * var(--sf)); background: #fff; padding-inline: calc(var(--u) / 2); position: relative; border: 2px solid var(--ink); box-sizing: border-box; }
  .nd-facts div { display: flex; justify-content: space-between; border-bottom: 1px solid #ccc; height: var(--u); box-sizing: border-box; line-height: calc(var(--u) - 1px); }
  .nd-facts div:last-child { border-bottom: 0; }
  .nd-facts-head { font-weight: 700; }
  .nd-small { grid-column: -31 / -3; grid-row: -4 / span 2; font-size: calc(11px * var(--sf)); color: #5a3d00; position: relative; margin-right: calc(10 * var(--u)); background: #ffc81e; align-self: start; }

  /* Ready: the one moment, steam over the lid. */
  .nd-lid::after { content: ''; position: absolute; inset: 20% 30% 40%; background: radial-gradient(closest-side, rgb(255 255 255 / 0.85), transparent); opacity: 0; pointer-events: none; }
  .noodle[data-steam] .nd-lid::after { animation: nd-steam 2.4s ease-out 2; }
  @keyframes nd-steam { 0% { opacity: 0; transform: translateY(0) scale(0.6); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(-30%) scale(1.3); } }
  @media (prefers-reduced-motion: reduce) { .nd-tick { transition: none; } }

  /* Narrow: the lid across the phone, then the steps, the timer and the label. */
  :root[data-narrow] .noodle { padding-bottom: calc(2 * var(--u)); }
  :root[data-narrow] .noodle > :not(.nd-wave) { grid-column: 2 / -2; grid-row: auto; padding-right: 0; margin-right: 0; }
  :root[data-narrow] .nd-wave { grid-area: auto; position: absolute; inset: 0; }
  :root[data-narrow] .nd-lid { height: calc(var(--d) * var(--u)); margin-block: var(--u) calc(2 * var(--u)); }
  :root[data-narrow] .nd-head { margin-bottom: var(--u); }
  :root[data-narrow] .nd-brand { font-size: calc(44px * var(--sf)); line-height: calc(3 * var(--u)); }
  :root[data-narrow] .nd-steps { grid-template-rows: none; grid-auto-rows: minmax(calc(3 * var(--u)), auto); gap: var(--u); margin-bottom: var(--u); }
  :root[data-narrow] .nd-steps li { grid-template-columns: calc(3 * var(--u)) calc(var(--u) / 2) 1fr; }
  :root[data-narrow] .nd-steps li::after { display: none; }
  :root[data-narrow] .nd-steps p { grid-column: 3; }
  :root[data-narrow] .nd-timer { grid-template-columns: 1fr; grid-template-rows: repeat(4, var(--u)) auto auto; gap: 0; margin-bottom: var(--u); }
  :root[data-narrow] .nd-go { grid-column: 1; grid-row: 5; margin-top: var(--u); }
  :root[data-narrow] .nd-status { grid-row: 6; margin-top: var(--u); width: auto; }
  :root[data-narrow] .nd-timer { grid-template-columns: minmax(0, 1fr); }
  :root[data-narrow] .nd-sub { width: auto; }
  :root[data-narrow] .nd-facts { margin-block: var(--u); }
</style>
