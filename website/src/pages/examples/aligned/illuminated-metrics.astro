---
// After an illuminated manuscript, used as an analytics dashboard: a quarter's figures for a monastery's
// honey shop, the numbers in roman numerals and rubricated, the orders as a bar chart of gilded
// squares, the visitors as a vine with a leaf at every week, and a drollery in the margin.
import AlignedStudy from '../../../layouts/AlignedStudy.astro';

const roman = (n: number) => {
  const table: [number, string][] = [[1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I']];
  let out = '';
  for (const [v, s] of table) while (n >= v) { out += s; n -= v; }
  return out;
};
const KPIS = [
  { label: 'Peregrini', gloss: 'visitors to the shop', value: 3742, change: 'more by XII in the hundred' },
  { label: 'Orders', gloss: 'jars and combs sent out', value: 312, change: 'more by VIII in the hundred' },
  { label: 'Coin taken', gloss: 'in pounds', value: 2840, change: 'more by XV in the hundred' },
  { label: 'Returned', gloss: 'jars broken on the road', value: 9, change: 'fewer by III' },
];
// Orders by week: thirteen weeks, a gilded square for every three orders.
const WEEKS = [18, 21, 19, 24, 27, 22, 25, 30, 28, 26, 24, 23, 25];
const VISITORS = [210, 236, 228, 251, 280, 262, 290, 365, 330, 301, 312, 318, 359];
const PER = 3;
---
<AlignedStudy slug="illuminated-metrics" theme="light" fonts="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=UnifrakturMaguntia&display=swap">
  <main class="stage scriptorium">
    <div class="ruling" aria-hidden="true"></div>

    <svg class="initial" viewBox="0 0 7 7" aria-hidden="true">
      <defs>
        <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f7e48c" /><stop offset="0.45" stop-color="#d4a62a" /><stop offset="0.6" stop-color="#f2d56b" /><stop offset="1" stop-color="#9c7314" /></linearGradient>
      </defs>
      <rect x="0" y="0" width="7" height="7" fill="url(#gold)" />
      <rect x="0.35" y="0.35" width="6.3" height="6.3" fill="#1f3f8f" />
      <path d="M0.8 0.8 Q 1.6 1.2 1.2 2 Q 0.8 2.6 1.4 3.2 M6.2 6.2 Q 5.4 5.8 5.8 5 Q 6.2 4.4 5.6 3.8 M0.8 6.2 Q 1.4 5.2 2.2 5.8 M6.2 0.8 Q 5.6 1.8 4.8 1.2" fill="none" stroke="#f3ead2" stroke-width="0.07" />
      <circle cx="1.2" cy="2" r="0.14" fill="#c8361e" /><circle cx="5.8" cy="5" r="0.14" fill="#c8361e" /><circle cx="2.2" cy="5.8" r="0.12" fill="#f3ead2" /><circle cx="4.8" cy="1.2" r="0.12" fill="#f3ead2" />
      <text x="3.5" y="5.35" text-anchor="middle" font-family="UnifrakturMaguntia, serif" font-size="5.6" fill="url(#gold)" stroke="#6b4c0c" stroke-width="0.05">Q</text>
    </svg>

    <header class="incipit">
      <h1><span class="sr">Q</span>uarterly reckoning of the Abbey honey shop</h1>
      <p>Here begin the accounts of the third quarter of the year MMXXVI: of the pilgrims who came to the shop, the jars and combs they bought, and the coin taken for them.</p>
    </header>

    <section class="kpis" aria-label="The quarter in four figures">
      {KPIS.map((k, i) => (
        <div class={`kpi ${i % 2 ? 'blue' : 'red'}`}>
          <h2>{k.label}</h2>
          <p class="numeral" aria-label={`${k.value}`}>{roman(k.value)}</p>
          <p class="gloss">{k.gloss}, that is {k.value.toLocaleString('en-GB')}; {k.change}</p>
        </div>
      ))}
    </section>

    <p class="summary"><span class="cap">T</span>he shop did better this quarter than any since the new hives were set on the south slope. <span class="cap blue-cap">M</span>ore came, more bought, and fewer jars were lost; the brothers give thanks and ask for more straw.</p>

    <svg class="border" id="border" aria-hidden="true"></svg>

    <figure class="bars">
      <figcaption><span class="pilcrow">¶</span> Orders by the week, each gilded square three orders</figcaption>
      <svg viewBox={`0 0 ${WEEKS.length * 2} 11`} role="img" aria-label={`Orders by week: ${WEEKS.join(', ')}`}>
        <defs>
          <linearGradient id="leaf-gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fbeb9c" /><stop offset="0.5" stop-color="#d4a62a" /><stop offset="1" stop-color="#a27a17" /></linearGradient>
        </defs>
        {WEEKS.map((n, i) => {
          const squares = Math.round(n / PER);
          return (
            <g>
              {Array.from({ length: squares }, (_, k) => (
                <g>
                  <rect x={i * 2 + 0.06} y={10 - k - 1 + 0.06} width="0.88" height="0.88" fill="url(#leaf-gold)" stroke="#7a5a10" stroke-width="0.04" />
                  <path d={`M${i * 2 + 0.2} ${10 - k - 0.25} L${i * 2 + 0.2} ${10 - k - 0.8} L${i * 2 + 0.75} ${10 - k - 0.8}`} fill="none" stroke="#fff8d0" stroke-width="0.06" opacity="0.8" />
                </g>
              ))}
              <text x={i * 2 + 0.5} y="10.8" text-anchor="middle" class="week">{roman(i + 1)}</text>
            </g>
          );
        })}
        <path d="M-0.4 10 H26" stroke="#c8361e" stroke-width="0.06" />
      </svg>
    </figure>

    <figure class="vine">
      <figcaption><span class="pilcrow blue-ink">¶</span> Pilgrims by the week, the vine climbing with them</figcaption>
      <svg id="vine" viewBox="0 0 16 11" role="img" aria-label={`Visitors by week: ${VISITORS.join(', ')}`}></svg>
    </figure>

    <aside class="margin" aria-label="Marginalia">
      <svg class="drollery" viewBox="0 0 10 13" role="img" aria-label="A drollery: a long-legged bird in a monk's hood, blowing a trumpet at the figures">
        <path d="M3.6 12.6 L4.4 8.6 M5.6 12.6 L5 8.6 M3 12.6 H4.2 M5.2 12.6 H6.4" stroke="#2b1d14" stroke-width="0.14" fill="none" stroke-linecap="round" />
        <path d="M2.4 7.6 C2.2 5.4 4 4.4 5.6 5 C7.4 5.6 8.6 7.4 8 8.6 C7 9.6 4.4 9.6 2.4 7.6 Z" fill="#1f3f8f" stroke="#2b1d14" stroke-width="0.08" />
        <path d="M3.2 7.4 C4.4 6.4 6 6.6 7.2 7.8" fill="none" stroke="#f3ead2" stroke-width="0.07" />
        <path d="M8 8.4 L9.6 9.4 L9.2 9.9 L7.6 9" fill="#c8361e" stroke="#2b1d14" stroke-width="0.06" />
        <path d="M3 5.4 C2.2 4.4 2.4 3 3.2 2.4" fill="none" stroke="#2b1d14" stroke-width="0.5" stroke-linecap="round" />
        <path d="M3 5.4 C2.2 4.4 2.4 3 3.2 2.4" fill="none" stroke="#e9dcc0" stroke-width="0.34" stroke-linecap="round" />
        <path d="M2.2 2.9 C2.3 1.4 3.9 0.8 4.6 1.9 C5 2.6 4.6 3.4 3.8 3.4 C3.2 3.4 2.6 3.4 2.2 2.9 Z" fill="#6a4a2a" stroke="#2b1d14" stroke-width="0.07" />
        <circle cx="3.9" cy="2.5" r="0.32" fill="#f1d7b8" stroke="#2b1d14" stroke-width="0.05" />
        <circle cx="4" cy="2.45" r="0.06" fill="#2b1d14" />
        <path d="M4.2 2.6 L6.6 2.1 L6.9 1.5 L7.2 3.3 L6.7 2.8 L4.2 2.8 Z" fill="url(#gold)" stroke="#6b4c0c" stroke-width="0.05" />
        <path d="M7.5 1.6 Q 8.2 1.2 8.6 1.6 M7.7 2.4 Q 8.6 2.4 9.1 2.8 M7.5 3.2 Q 8.2 3.6 8.5 4.2" fill="none" stroke="#c8361e" stroke-width="0.07" />
      </svg>
      <p class="nota"><span class="hand-point">☞</span> Nota: the great rise in the eighth week came of the honey fair at Wenlock, where Brother Anselm sold the last of the heather comb by noon.</p>
      <p class="nota">The jars broken were all on the carrier's road by Much Marcle. Let them be packed in straw.</p>
    </aside>

    <p class="explicit"><span class="pilcrow">¶</span> Explicit. Here end the accounts of the quarter.</p>
  </main>
</AlignedStudy>

<script>
  // The vine: a smooth stem through the thirteen weeks, a leaf at each week, turning side to side,
  // and a red berry where the week's count sits.
  const DATA = [210, 236, 228, 251, 280, 262, 290, 365, 330, 301, 312, 318, 359];
  const vine = document.getElementById('vine') as unknown as SVGSVGElement;
  const W = 16, H = 11, low = 180, high = 380;
  const pts = DATA.map((v, i) => [0.6 + (i * (W - 1.2)) / (DATA.length - 1), H - 0.8 - ((v - low) / (high - low)) * (H - 1.6)] as [number, number]);
  let d = `M${pts[0][0]} ${H} L${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) {
    const [x0, y0] = pts[i - 1], [x1, y1] = pts[i];
    const mx = (x0 + x1) / 2;
    d += ` C${mx} ${y0 + (i % 2 ? -0.6 : 0.6)} ${mx} ${y1 + (i % 2 ? 0.6 : -0.6)} ${x1} ${y1}`;
  }
  const leaves = pts.map(([x, y], i) => {
    const side = i % 2 ? 1 : -1;
    const angle = side * 50 - 20;
    return `<path d="M0 0 C0.3 -0.35 0.9 -0.4 1.2 0 C0.9 0.4 0.3 0.35 0 0 Z" transform="translate(${x} ${y}) rotate(${angle})" class="leaf"/>
      <path d="M0 0 L1 0" transform="translate(${x} ${y}) rotate(${angle})" class="rib"/>`;
  }).join('');
  const berries = pts.map(([x, y]) => `<circle cx="${x}" cy="${y}" r="0.2" class="berry"/>`).join('');
  const tendrils = pts.filter((_, i) => i % 3 === 1).map(([x, y]) => `<path d="M${x} ${y} c0.3 0.5 0.9 0.5 0.9 0 c0 -0.4 -0.5 -0.4 -0.5 -0.1" class="tendril"/>`).join('');
  const labels = [200, 300].map(v => { const y = H - 0.8 - ((v - low) / (high - low)) * (H - 1.6); return `<path d="M0 ${y} H${W}" class="guide"/><text x="${W}" y="${y - 0.15}" class="scale">${v === 200 ? 'CC' : 'CCC'}</text>`; }).join('');
  vine.innerHTML = `${labels}<path d="${d}" class="stem"/>${tendrils}${leaves}${berries}`;

  // A bar border down from the initial: a stem in red and blue, an ivy leaf every two squares,
  // a gilded bezant between, drawn to whatever height the window leaves.
  import { onSquares } from '../../../lib/aligned-study';
  const border = document.getElementById('border') as unknown as SVGSVGElement;
  onSquares(({ down, narrow }) => {
    if (narrow) return;
    const high = down - 14;
    border.setAttribute('viewBox', `0 0 2 ${high}`);
    border.style.setProperty('--border-h', String(high));
    let out = `<path d="M1 0 V${high}" stroke="#1f3f8f" stroke-width="0.22"/><path d="M1 0 V${high}" stroke="#c8361e" stroke-width="0.08"/>`;
    for (let y = 1; y < high; y += 2) {
      const side = (y - 1) % 4 ? 1 : -1;
      out += `<path d="M1 ${y} q${side * 0.4} -0.1 ${side * 0.7} 0.4" fill="none" stroke="#4f7a3a" stroke-width="0.06"/>`;
      out += `<path d="M${1 + side * 0.7} ${y + 0.4} c${side * 0.2} -0.35 ${side * 0.6} -0.3 ${side * 0.55} 0.1 c${side * 0.1} 0.3 ${-side * 0.1} 0.5 ${-side * 0.55} 0.35 Z" fill="#6f9a4a" stroke="#2f4a22" stroke-width="0.04"/>`;
      out += `<circle cx="${1 - side * 0.55}" cy="${y + 1}" r="0.16" fill="url(#gold)" stroke="#7a5a10" stroke-width="0.03"/>`;
    }
    border.innerHTML = out;
  });
</script>

<style is:global>
  html { background: #efe3c4; }
  .scriptorium {
    --vellum: #efe3c4;
    --ink: #2b1d14;
    --red: #c8361e;
    --blue: #1f3f8f;
    --gold: #c9a227;
    --leaf: #4f7a3a;
    color: var(--ink);
    font-family: 'IM Fell English', 'Hoefler Text', Georgia, serif;
    font-size: calc(16px * var(--sf));
    line-height: var(--u);
    background:
      radial-gradient(ellipse at 85% 90%, rgb(160 120 60 / 0.18), transparent 35%),
      radial-gradient(ellipse at 10% 15%, rgb(160 120 60 / 0.12), transparent 30%),
      radial-gradient(circle at 60% 40%, rgb(255 250 230 / 0.4), transparent 50%),
      var(--vellum);
  }
  :where(.scriptorium) :is(p, h1, h2, figure) { margin: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  /* The text block's frame: a red and a blue rule, a square inside the window's edge. */
  .ruling { grid-column: 3 / -3; grid-row: 2 / -2; box-shadow: inset 0 0 0 1px var(--red), inset 0 0 0 calc(4px * var(--sf)) var(--vellum), inset 0 0 0 calc(5px * var(--sf)) var(--blue); pointer-events: none; }

  .border { grid-column: 4 / span 2; grid-row: 11 / span var(--border-h, 30); width: 100%; height: 100%; overflow: visible; }
  .summary { grid-column: 6 / -16; grid-row: 19 / span 3; max-width: calc(44 * var(--u)); }
  .cap { font: calc(30px * var(--sf)) / 0 UnifrakturMaguntia, serif; color: var(--red); vertical-align: -0.1em; margin-right: 0.04em; }
  .cap.blue-cap { color: var(--blue); }
  .initial { grid-column: 5 / span 7; grid-row: 4 / span 7; width: 100%; height: 100%; filter: drop-shadow(0 1px 0 rgb(80 50 10 / 0.35)); }

  .incipit { grid-column: 13 / -16; grid-row: 4 / span 7; }
  .incipit h1 { font: normal calc(40px * var(--sf)) / calc(3 * var(--u)) UnifrakturMaguntia, 'Apple Chancery', serif; color: var(--red); margin-bottom: var(--u); }
  .incipit p { font-style: italic; max-width: calc(34 * var(--u)); }

  .kpis { grid-column: 6 / -16; grid-row: 12 / span 6; display: grid; grid-template-columns: repeat(4, 1fr); column-gap: var(--u); }
  .kpi h2 { font: normal calc(22px * var(--sf)) / calc(2 * var(--u)) UnifrakturMaguntia, 'Apple Chancery', serif; }
  .kpi.red h2 { color: var(--red); }
  .kpi.blue h2 { color: var(--blue); }
  .numeral { font-size: calc(28px * var(--sf)); line-height: calc(2 * var(--u)); letter-spacing: 0.04em; white-space: nowrap; }
  .numeral::first-letter { color: var(--red); }
  .kpi.blue .numeral::first-letter { color: var(--blue); }
  .gloss { font-style: italic; font-size: calc(13px * var(--sf)); color: #5a4532; }

  .scriptorium figcaption { font-style: italic; margin-bottom: var(--u); }
  .pilcrow { color: var(--red); font-style: normal; font-weight: bold; }
  .pilcrow.blue-ink { color: var(--blue); }
  .bars { grid-column: 6 / span 27; grid-row: -17 / span 13; }
  .bars svg { display: block; width: calc(26 * var(--u)); height: calc(11 * var(--u)); overflow: visible; }
  .bars .week { font: 0.5px 'IM Fell English', serif; fill: var(--red); }

  .vine { grid-column: 34 / -16; grid-row: -17 / span 13; }
  .vine svg { display: block; width: 100%; height: calc(11 * var(--u)); overflow: visible; }
  .vine .stem { fill: none; stroke: var(--leaf); stroke-width: 0.14; stroke-linecap: round; }
  .vine .leaf { fill: #6f9a4a; stroke: #2f4a22; stroke-width: 0.04; }
  .vine .rib { stroke: #2f4a22; stroke-width: 0.03; }
  .vine .berry { fill: var(--red); stroke: #6a1408; stroke-width: 0.04; }
  .vine .tendril { fill: none; stroke: var(--leaf); stroke-width: 0.05; }
  .vine .guide { stroke: rgb(200 54 30 / 0.3); stroke-width: 0.03; stroke-dasharray: 0.15 0.15; }
  .vine .scale { font: italic 0.5px 'IM Fell English', serif; fill: var(--red); text-anchor: end; }

  .margin { grid-column: -14 / -4; grid-row: 4 / -4; display: flex; flex-direction: column; gap: var(--u); }
  .drollery { width: calc(10 * var(--u)); height: calc(13 * var(--u)); }
  .nota { font-style: italic; font-size: calc(14px * var(--sf)); color: #4a3826; }
  .hand-point { color: var(--red); font-style: normal; }
  .explicit { grid-column: 6 / -16; grid-row: -3 / span 1; font-style: italic; font-size: calc(13px * var(--sf)); }

  :root[data-narrow] .scriptorium { padding-bottom: calc(3 * var(--u)); }
  :root[data-narrow] .scriptorium > :not(.ruling) { grid-column: 2 / -2; grid-row: auto; margin-top: var(--u); }
  :root[data-narrow] .ruling { display: none; }
  :root[data-narrow] .initial { width: calc(5 * var(--u)); height: calc(5 * var(--u)); }
  :root[data-narrow] .incipit h1 { font-size: calc(30px * var(--sf)); line-height: calc(2 * var(--u)); }
  :root[data-narrow] .kpis { grid-template-columns: 1fr; row-gap: var(--u); }
  :root[data-narrow] .border, :root[data-narrow] .summary { display: none; }
  :root[data-narrow] .bars svg { width: 100%; height: auto; aspect-ratio: 26 / 11; }
  :root[data-narrow] .drollery { width: calc(8 * var(--u)); height: calc(10 * var(--u)); }
</style>
