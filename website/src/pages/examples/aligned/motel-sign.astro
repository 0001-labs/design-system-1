---
// After a roadside neon motel sign at night: a sheet-metal panel with its name in script tube, a
// VACANCY box that catches once on load, an arrow of bulbs pointing at the office, and a letter
// board of tonight's rates for whatever is flying south. Every tube, bulb and groove sits on the
// squares: the scene is drawn in a viewBox of squares, and the board's grooves are its rows.
import AlignedStudy from '../../../layouts/AlignedStudy.astro';
---
<AlignedStudy slug="motel-sign" theme="dark">
  <main class="stage motel" id="motel">
    <h1 class="motel-sr">Flyway Motor Court: vacancy, rates by the night for geese, swans and cranes</h1>
    <svg class="motel-scene" id="motel-scene" aria-hidden="true"></svg>
    <button type="button" class="motel-vac" id="motel-vac" aria-pressed="false">Light the NO</button>
    <section class="motel-board" id="motel-board" aria-label="Tonight's rates">
      <ul id="motel-lines"></ul>
    </section>
    <p class="motel-curb">Flyway Motor Court, Route 9 at Marsh Junction. Open all season, both directions. Pond view from every room; ring the bell twice for the night porter.</p>
  </main>
</AlignedStudy>

<script>
  import { onSquares } from '../../../lib/aligned-study';

  /** The letter board, twelve letters a row, as the night man set it out. */
  const BOARD = [
    "TONIGHT'S", 'RATES', '',
    'GEESE   4.00', 'SWANS   9.50', ' PAIRS ONLY', 'CRANES  6.00', 'DUCKS   2.25', 'GOSLING FREE', '',
    'NO HERONS', 'HEATED POND', 'COLOR TV', 'CHECKOUT AT', 'FIRST LIGHT',
  ];
  const BOARD_WIDTH = 12;

  const stage = document.getElementById('motel')!;
  const scene = document.getElementById('motel-scene') as unknown as SVGSVGElement;
  const board = document.getElementById('motel-board')!;
  const lines = document.getElementById('motel-lines')!;
  const vacancy = document.getElementById('motel-vac') as HTMLButtonElement;

  // The board's letters: one per square, a few of them pushed on a little crooked.
  lines.innerHTML = BOARD.map((line, row) => {
    const letters = line.padEnd(BOARD_WIDTH, ' ').split('').map((ch, col) => {
      const wobble = ((row * 7 + col * 13) % 11) - 5;
      const tilt = Math.abs(wobble) > 3 ? ` style="--tilt:${wobble * 0.7}deg"` : '';
      return `<span${tilt}>${ch === ' ' ? '' : ch}</span>`;
    }).join('');
    return `<li aria-label="${line.trim() || 'blank'}">${letters}</li>`;
  }).join('');

  /** A small seeded random, so the stars stay where they were on every resize. */
  function seeded(seed: number) {
    return () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
  }

  vacancy.addEventListener('click', () => {
    const full = !stage.hasAttribute('data-full');
    stage.toggleAttribute('data-full', full);
    vacancy.setAttribute('aria-pressed', String(full));
    vacancy.textContent = full ? 'Put the NO out' : 'Light the NO';
  });

  onSquares(({ across, down, narrow }) => {
    const wide = across;
    const high = narrow ? 22 : down;
    const ground = high - 4;
    scene.setAttribute('viewBox', `0 0 ${wide} ${high}`);
    scene.style.gridRow = `1 / span ${high}`;

    // The sign: a panel as wide as the room beside the board allows.
    const boardLeft = narrow ? wide : wide - 16;
    const pw = narrow ? 12 : Math.max(16, Math.min(30, boardLeft - 22));
    const px = narrow ? 1 : 3;
    const py = narrow ? 3 : 3;
    const ph = narrow ? 8 : Math.round(pw * 0.42);
    const vf = narrow ? 0.85 : 1.7;
    const pole = px + Math.round(pw * 0.35);
    const vy = py + ph + 1;
    const vx = narrow ? px + 1 : px + 2;
    const vw = narrow ? pw - 2 : pw - 4;
    const cx = px + pw / 2;

    const random = seeded(41);
    const stars: string[] = [];
    for (let i = 0; i < (wide * ground) / 14; i++) {
      const x = Math.floor(random() * wide);
      const y = Math.floor(random() * (ground - 2));
      const r = 0.04 + random() * 0.08;
      stars.push(`<circle cx="${x}" cy="${y}" r="${r.toFixed(2)}" opacity="${(0.35 + random() * 0.6).toFixed(2)}" />`);
    }

    // Geese going over, in a V, between the sign and the board.
    const gx = narrow ? 9 : Math.round(px + pw + (boardLeft - px - pw) / 2);
    const gy = narrow ? 1 : 3;
    const geese = [[0, 0], [-1.2, 0.8], [-2.4, 1.6], [-3.6, 2.4], [1.2, 0.8], [2.4, 1.6], [3.4, 2.5]]
      .slice(0, narrow ? 5 : 7)
      .map(([dx, dy]) => `<path d="M ${gx + dx - 0.45} ${gy + dy + 0.18} Q ${gx + dx - 0.2} ${gy + dy - 0.05} ${gx + dx} ${gy + dy + 0.12} Q ${gx + dx + 0.2} ${gy + dy - 0.05} ${gx + dx + 0.45} ${gy + dy + 0.18}" />`).join('');

    // The arrow of bulbs, from the panel to the office, when there is room for both.
    const arrowX = px + pw + 4;
    const roomForArrow = !narrow && arrowX + 8 < boardLeft - 1;
    const head = ground - 9;
    let arrow = '';
    if (roomForArrow) {
      const ay = py + Math.round(ph / 2);
      const bulbs: number[][] = [];
      for (let x = px + pw + 1; x <= arrowX; x++) bulbs.push([x, ay]);
      for (let y = ay + 1; y <= head; y++) bulbs.push([arrowX, y]);
      const headBulbs = [[arrowX - 2, head], [arrowX - 1, head + 1], [arrowX, head + 3], [arrowX + 1, head + 1], [arrowX + 2, head], [arrowX, head + 2]];
      arrow = `
        <path class="arrow-body" d="M ${px + pw} ${ay} H ${arrowX} V ${head}" />
        <path class="arrow-body" d="M ${arrowX - 2.6} ${head - 0.4} H ${arrowX + 2.6} L ${arrowX} ${head + 3.6} Z" stroke-width="0" />
        <g class="bulbs">${[...bulbs, ...headBulbs].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="0.24" />`).join('')}</g>
        <g class="office">
          <rect class="building" x="${arrowX - 7}" y="${ground - 6}" width="14" height="6" />
          <rect class="eave" x="${arrowX - 8}" y="${ground - 6}" width="16" height="0.5" />
          <rect class="window" x="${arrowX - 6}" y="${ground - 4}" width="5" height="2" />
          <rect class="blind" x="${arrowX - 6}" y="${ground - 4}" width="5" height="0.6" />
          <rect class="door" x="${arrowX + 2}" y="${ground - 4}" width="2" height="4" />
          <text class="neon cyan" x="${arrowX + 3}" y="${ground - 4.6}" font-size="0.9" text-anchor="middle">OFFICE</text>
        </g>`;
    }

    // Parking bays under the board, a stripe every four squares.
    const bays: string[] = [];
    const baysFrom = roomForArrow ? arrowX + 10 : narrow ? wide : px + pw + 4;
    for (let x = baysFrom; x <= wide - 2; x += 4) bays.push(`<rect x="${x}" y="${ground + 1}" width="0.16" height="2" />`);

    const legs = narrow ? '' : `
      <rect class="leg" x="${boardLeft + 3}" y="${3 + BOARD.length + 2}" width="0.4" height="${ground - 5 - BOARD.length}" />
      <rect class="leg" x="${boardLeft + 10.6}" y="${3 + BOARD.length + 2}" width="0.4" height="${ground - 5 - BOARD.length}" />`;

    const burst = Array.from({ length: 8 }, (_, i) => {
      const a = (i / 8) * Math.PI * 2;
      const r1 = 0.6, r2 = i % 2 ? 1.6 : 2.6;
      const bx = px + pw - 2, by = py - 0.5;
      return `M ${(bx + Math.cos(a) * r1).toFixed(2)} ${(by + Math.sin(a) * r1).toFixed(2)} L ${(bx + Math.cos(a) * r2).toFixed(2)} ${(by + Math.sin(a) * r2).toFixed(2)}`;
    }).join(' ');

    scene.innerHTML = `
      <defs>
        <linearGradient id="motel-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#0b0f2c" />
          <stop offset="0.7" stop-color="#16244a" />
          <stop offset="1" stop-color="#2c4a63" />
        </linearGradient>
        <filter id="motel-glow" x="-30%" y="-60%" width="160%" height="220%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="0.18" result="near" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="0.7" result="far" />
          <feMerge><feMergeNode in="far" /><feMergeNode in="near" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <rect width="${wide}" height="${ground}" fill="url(#motel-sky)" />
      <g class="stars">${stars.join('')}</g>
      <g class="geese">${geese}</g>
      <rect class="asphalt" y="${ground}" width="${wide}" height="${high - ground}" />
      <rect class="kerb" y="${ground}" width="${wide}" height="0.3" />
      <g class="bays">${bays.join('')}</g>
      ${legs}
      <rect class="pole" x="${pole}" y="${vy + 3}" width="2" height="${ground - vy - 3}" />
      <rect class="pole" x="${pole}" y="${py + ph}" width="2" height="1" />
      ${arrow}
      <path class="neon yellow" d="${burst}" fill="none" stroke-width="0.16" stroke-linecap="round" />
      <rect class="panel" x="${px}" y="${py}" width="${pw}" height="${ph}" rx="0.5" />
      <rect class="tube cyan" x="${px + 0.8}" y="${py + 0.8}" width="${pw - 1.6}" height="${ph - 1.6}" rx="0.7" />
      <text class="neon pink script" x="${cx}" y="${py + ph * 0.55}" font-size="${(pw * 0.27).toFixed(2)}" text-anchor="middle">Flyway</text>
      <text class="neon cyan block" x="${cx}" y="${py + ph - 1.4}" font-size="${(pw * 0.058).toFixed(2)}" text-anchor="middle" letter-spacing="0.3">MOTOR COURT</text>
      <rect class="vbox" x="${vx}" y="${vy}" width="${vw}" height="3" />
      <text class="no" x="${vx + 1}" y="${vy + 1.5 + vf * 0.36}" font-size="${vf}">NO</text>
      <text class="neon red block vac" x="${vx + vw - 1}" y="${vy + 1.5 + vf * 0.36}" font-size="${vf}" text-anchor="end" letter-spacing="0.12">VACANCY</text>
    `;

    // The button lies over the VACANCY box; the board stands on the right.
    vacancy.style.gridColumn = `${vx + 1} / span ${vw}`;
    vacancy.style.gridRow = `${vy + 1} / span 3`;
    if (!narrow) {
      board.style.gridColumn = `${boardLeft + 1} / span 14`;
      board.style.gridRow = `3 / span ${BOARD.length + 2}`;
    } else {
      board.style.gridColumn = '';
      board.style.gridRow = '';
    }
  });
</script>

<style is:global>
  html { background: #0b0f2c; }
  .motel {
    --pink: #ff5fae;
    --cyan: #5ff0ff;
    --red: #ff3b2f;
    --bulb: #ffe7a3;
    color: #e9e4d6;
    font-family: var(--typeface-regular);
    font-size: calc(14px * var(--sf));
    line-height: var(--u);
    background: #0b0f2c;
  }
  .motel-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .motel-scene { grid-column: 1 / -1; grid-row: 1 / -1; width: 100%; height: 100%; display: block; }
  .motel-scene .stars { fill: #f3f0ff; }
  .motel-scene .geese { fill: none; stroke: #cfd6e8; stroke-width: 0.08; stroke-linecap: round; opacity: 0.8; }
  .motel-scene .asphalt { fill: #15141d; }
  .motel-scene .kerb { fill: #5b5a66; }
  .motel-scene .bays { fill: #d9d4c4; opacity: 0.7; }
  .motel-scene .pole, .motel-scene .leg { fill: #3b4253; }
  .motel-scene .panel { fill: #0e3a40; stroke: #e6dcc3; stroke-width: 0.25; }
  .motel-scene .vbox { fill: #141016; stroke: #e6dcc3; stroke-width: 0.25; }
  .motel-scene .building { fill: #231d31; }
  .motel-scene .eave { fill: #e6dcc3; }
  .motel-scene .window { fill: #ffcc6e; }
  .motel-scene .blind { fill: #d79a3f; }
  .motel-scene .door { fill: #3d3350; }
  .motel-scene .arrow-body { fill: #b8302a; stroke: #b8302a; stroke-width: 2; stroke-linejoin: miter; }
  .motel-scene .arrow-body:first-child { fill: none; }
  .motel-scene path.arrow-body { fill: none; }
  .motel-scene path.arrow-body[stroke-width='0'] { fill: #b8302a; }
  .motel-scene .bulbs { fill: var(--bulb); filter: url(#motel-glow); }

  /* Neon: a pale core inside its colour, and the glow around both. */
  .motel-scene .neon { filter: url(#motel-glow); stroke-width: 0.07; paint-order: stroke; }
  .motel-scene .pink { fill: #ffe0f0; stroke: var(--pink); }
  .motel-scene .cyan { fill: #e1fcff; stroke: var(--cyan); }
  .motel-scene .red { fill: #ffd9d4; stroke: var(--red); }
  .motel-scene .yellow { stroke: #ffd36a; }
  .motel-scene .tube { fill: none; stroke: var(--cyan); stroke-width: 0.13; filter: url(#motel-glow); }
  .motel-scene .script { font-family: SignPainter, 'Snell Roundhand', 'Brush Script MT', cursive; stroke-width: 0.1; }
  .motel-scene .block { font-family: Futura, 'Avenir Next', sans-serif; font-weight: 600; }
  .motel-scene .no { font-family: Futura, 'Avenir Next', sans-serif; font-weight: 600; fill: none; stroke: #5a3a3d; stroke-width: 0.07; }

  /* Lit, the NO is the same red; the VACANCY catches once as the transformer warms. */
  .motel[data-full] .motel-scene .no { fill: #ffd9d4; stroke: var(--red); filter: url(#motel-glow); }
  .motel-scene .vac { animation: motel-catch 2.2s steps(1, end) 0.7s both; }
  @keyframes motel-catch {
    0% { opacity: 0.12; } 6% { opacity: 1; } 9% { opacity: 0.2; } 15% { opacity: 1; } 18% { opacity: 0.12; }
    38% { opacity: 0.12; } 41% { opacity: 0.8; } 44% { opacity: 0.25; } 47% { opacity: 1; } 100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .motel-scene .vac { animation: none; } }

  .motel-vac {
    all: unset;
    z-index: 1;
    cursor: pointer;
    color: transparent;
    font-size: 1px;
  }
  .motel-vac:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }

  /* The letter board: black, grooved every square, twelve white letters to a row. */
  .motel-board {
    z-index: 1;
    padding: var(--u);
    background:
      repeating-linear-gradient(to bottom, #18171c 0 calc(var(--u) - 2px), #2c2a33 calc(var(--u) - 2px) var(--u));
    box-shadow: inset 0 0 0 calc(var(--u) / 4) #a6a7ae, inset 0 0 0 calc(var(--u) / 4 + 1px) #5d5e66;
  }
  .motel-board ul { margin: 0; padding: 0; list-style: none; }
  .motel-board li { display: grid; grid-template-columns: repeat(12, var(--u)); height: var(--u); }
  .motel-board span {
    display: block;
    text-align: center;
    font-family: var(--typeface-medium);
    font-size: calc(18px * var(--sf));
    line-height: var(--u);
    color: #f6f3ea;
    transform: rotate(var(--tilt, 0deg));
  }

  .motel-curb {
    grid-column: 3 / span 30;
    grid-row: -3 / span 2;
    z-index: 1;
    margin: 0;
    font-size: calc(12px * var(--sf));
    color: #a9a7b8;
  }

  /* A phone: the sign over its lot, then the board, then the kerb. */
  :root[data-narrow] .motel { padding-bottom: calc(3 * var(--u)); }
  :root[data-narrow] .motel-scene { grid-column: 1 / -1; }
  :root[data-narrow] .motel-board { grid-column: 2 / -2; grid-row: auto; padding: 0; margin-top: var(--u); box-shadow: none; outline: calc(var(--u) / 4) solid #a6a7ae; }
  :root[data-narrow] .motel-curb { grid-column: 2 / -2; grid-row: auto; margin-top: calc(2 * var(--u)); }
</style>
